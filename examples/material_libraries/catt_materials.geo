; Materials in CATT-Acoustic's format: ABS name = <absorption> L <scattering> {colour},
; in percent from 125 Hz to 4 kHz. Values for this example, not from a CATT library.
ABS carpet = <8 24 57 69 71 73> L <10 10 10 15 20 25> {150 60 60}
ABS plasterboard = <29 10 5 4 7 9> L <5 5 5 5 10 10> {230 230 220}
ABS walls = plasterboard   ; another name for the same material
