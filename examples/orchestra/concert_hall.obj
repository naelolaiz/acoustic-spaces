# Shoebox concert hall, 32 x 20 x 15 m, with a stage 8 m deep and 1 m high at x = 0..8.
# Origin at the floor below the stage's back corner, +z up. Face normals point into the
# room. Groups name the surfaces that scene.yaml assigns.
v 8 0 0
v 32 0 0
v 32 20 0
v 8 20 0
v 0 0 1
v 8 0 1
v 8 20 1
v 0 20 1
v 0 0 15
v 32 0 15
v 32 20 15
v 0 20 15

g audience_floor
f 1 2 3
f 1 3 4

g stage_floor
f 5 6 7
f 5 7 8

g stage_front
f 1 4 7
f 1 7 6

g stage_wall
f 5 8 12
f 5 12 9

g rear_wall
f 2 11 3
f 2 10 11

g side_walls
f 6 2 1
f 6 10 2
f 6 9 10
f 6 5 9
f 7 4 3
f 7 3 11
f 7 11 12
f 7 12 8

g ceiling
f 9 12 11
f 9 11 10
