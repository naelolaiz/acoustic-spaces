#, python-brace-format
msgid "Measured profile at {count} height, from the scene file"
msgid_plural "Measured profile at {count} heights, from the scene file"
msgstr[0] "Gemeten profiel op {count} hoogte, uit het scènebestand"
msgstr[1] "Gemeten profiel op {count} hoogtes, uit het scènebestand"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "{name} {hours:g} h +{penalty:g} dB"
msgstr "{name} {hours:g} u +{penalty:g} dB"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "{name} {hours:g} h"
msgstr "{name} {hours:g} u"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Levels over a long term: {count} weather class over {periods} ({rating})"
msgid_plural ""
"Levels over a long term: {count} weather classes over {periods} ({rating})"
msgstr[0] ""
"Niveaus over een lange termijn: {count} weerklasse over {periods} ({rating})"
msgstr[1] ""
"Niveaus over een lange termijn: {count} weerklassen over {periods} ({rating})"

