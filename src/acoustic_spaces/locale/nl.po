#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "The share of the {period} this weather class holds (%)"
msgstr "Het deel van de periode {period} waarin deze weerklasse heerst (%)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Surface area: {area:,.1f} m²"
msgstr "Oppervlakte: {area:,.1f} m²"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³ in {count} room ({each} m³)"
msgid_plural "Volume: {volume:,.1f} m³ in {count} rooms ({each} m³)"
msgstr[0] "Volume: {volume:,.1f} m³ in {count} ruimte ({each} m³)"
msgstr[1] "Volume: {volume:,.1f} m³ in {count} ruimtes ({each} m³)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³"
msgstr "Volume: {volume:,.1f} m³"

#: acoustic_spaces/gui/inspector.py
msgid "Volume: model not closed"
msgstr "Volume: model niet gesloten"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Reverberation time at {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s "
"(Sabine)"
msgstr ""
"Nagalmtijd bij {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s (Sabine)"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/yaml_panel.py
#, python-brace-format
msgid "Problem: {problem}"
msgstr "Probleem: {problem}"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/yaml_panel.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "Waarschuwing: {warning}"

#: acoustic_spaces/gui/inspector.py
msgid "rename scene"
msgstr "scène hernoemen"

#: acoustic_spaces/gui/inspector.py
msgid "change default material"
msgstr "standaardmateriaal wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "change air"
msgstr "luchtinstellingen wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather"
msgstr "weer wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather zone"
msgstr "weerzone wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather class"
msgstr "weerklasse wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "add weather class"
msgstr "weerklasse toevoegen"

#: acoustic_spaces/gui/inspector.py
msgid "remove weather class"
msgstr "weerklasse verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid "a share of the time is a number from 0 to 100 %"
msgstr "een aandeel van de tijd is een getal van 0 tot 100 %"

#: acoustic_spaces/gui/inspector.py
msgid "remove weather zone"
msgstr "weerzone verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid "change the eddies"
msgstr "turbulentie wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "change the wind and temperature"
msgstr "wind en temperatuur wijzigen"

#: acoustic_spaces/gui/inspector.py
msgid "remove the measured profile"
msgstr "gemeten profiel verwijderen"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Wind and temperature of {name}"
msgstr "Wind en temperatuur van {name}"

#: acoustic_spaces/gui/inspector.py
msgid "Box"
msgstr "Rechthoekige ruimte"

#: acoustic_spaces/gui/inspector.py
msgid "Length (x)"
msgstr "Lengte (x)"

#: acoustic_spaces/gui/inspector.py
msgid "Width (y)"
msgstr "Breedte (y)"

#: acoustic_spaces/gui/inspector.py
msgid "Height (z)"
msgstr "Hoogte (z)"

#: acoustic_spaces/gui/inspector.py
msgid "How long the room is along x, in the units the title shows"
msgstr "De lengte van de ruimte langs x, in de eenheden die in de titel staan"

#: acoustic_spaces/gui/inspector.py
msgid "How wide the room is along y, in the units the title shows"
msgstr "De breedte van de ruimte langs y, in de eenheden die in de titel staan"

#: acoustic_spaces/gui/inspector.py
msgid "How high the room is, floor to ceiling, in the units the title shows"
msgstr ""
"De hoogte van de ruimte van vloer tot plafond, in de eenheden die in de "
"titel staan"

#: acoustic_spaces/gui/inspector.py
msgid "Floor plan"
msgstr "Plattegrond"

#. Translators: {axis} is x or y.
#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"The {axis} of each corner, in the units the title shows; the corners go "
"round the room in turn"
msgstr ""
"De {axis}-coördinaat van elke hoek, in de eenheden die in de titel staan; de "
"hoeken volgen op volgorde de omtrek van de ruimte"

#: acoustic_spaces/gui/inspector.py
msgid "Add corner"
msgstr "Hoek toevoegen"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/plan_view.py
msgid "Remove corner"
msgstr "Hoek verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid "Add a corner halfway between the last corner and the first"
msgstr "Een hoek halverwege de laatste en de eerste hoek toevoegen"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected corner, or the last one when none is selected"
msgstr ""
"De geselecteerde hoek verwijderen, of de laatste als er geen is geselecteerd"

#: acoustic_spaces/gui/inspector.py
msgid "The model file the room comes from"
msgstr "Het modelbestand waaruit de ruimte komt"

#: acoustic_spaces/gui/inspector.py
msgid "Choose another file…"
msgstr "Ander bestand kiezen…"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Take the room from another model file; the materials and their assignments "
"stay"
msgstr ""
"De ruimte uit een ander modelbestand overnemen; de materialen en hun "
"toewijzingen blijven behouden"

#: acoustic_spaces/gui/inspector.py
msgid "file default"
msgstr "bestandsstandaard"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The unit the model's lengths are in; file default: the units a DXF, IFC or "
"Collada file records, else metres"
msgstr ""
"De lengte-eenheid van het model; bestandsstandaard: de eenheden die in een "
"DXF-, IFC- of Collada-bestand zijn vastgelegd, anders meters"

#: acoustic_spaces/gui/inspector.py
msgid "format default"
msgstr "formaatstandaard"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The axis that points up in the model; format default: y for glTF and "
"SketchUp, the one a Collada file records, z for the others (Blender's OBJ "
"export writes y up)"
msgstr ""
"De as die in het model omhoog wijst; formaatstandaard: y voor glTF en "
"SketchUp, de as die in een Collada-bestand is vastgelegd, z voor de overige "
"formaten (de OBJ-export van Blender gebruikt y als verticale as)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The room of an IFC model to take on its own, from its space boundaries; "
"every element reads walls as solids, with both sides"
msgstr ""
"De ruimte uit een IFC-model die afzonderlijk via de ruimtegrenzen wordt "
"overgenomen; alle elementen leest wanden als volumes met beide zijden"

#: acoustic_spaces/gui/inspector.py
msgid "Units"
msgstr "Eenheden"

#: acoustic_spaces/gui/inspector.py
msgid "Up axis"
msgstr "Verticale as"

#: acoustic_spaces/gui/inspector.py
msgid "IFC room"
msgstr "IFC-ruimte"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The height (z) of the flat ground, or added to the terrain's heights, in the "
"units the title shows"
msgstr ""
"De hoogte (z) van de vlakke grond, of opgeteld bij de hoogtes van het "
"reliëf, in de eenheden die in de titel staan"

#: acoustic_spaces/gui/inspector.py
msgid ""
"How far the ground reaches past the buildings, barriers and model, unless "
"its extent is set or a terrain sets its size, and how high the sky is over "
"the highest of them, unless the sky is set; in the units the title shows"
msgstr ""
"Hoe ver de grond voorbij de gebouwen, geluidsschermen en het model reikt, "
"tenzij de omvang ervan is ingesteld of een reliëf de grootte bepaalt, en hoe "
"hoog de hemel boven de hoogste ervan ligt, tenzij de hemel is ingesteld; in "
"de eenheden die in de titel staan"

#: acoustic_spaces/gui/inspector.py
msgid ""
"How high the open sky lies over the ground, in the units the title shows; "
"auto: the margin over the highest building, barrier or model part. Sound "
"that reaches the sky leaves the scene"
msgstr ""
"Hoe hoog de open hemel boven de grond ligt, in de eenheden die in de titel "
"staan; automatisch: de marge boven het hoogste gebouw, geluidsscherm of "
"modeldeel. Geluid dat de hemel bereikt, verlaat de scène"

#: acoustic_spaces/gui/inspector.py
msgid "Ground height"
msgstr "Grondhoogte"

#: acoustic_spaces/gui/inspector.py
msgid "Margin"
msgstr "Marge"

#: acoustic_spaces/gui/inspector.py
msgid "Sky"
msgstr "Hemel"

#: acoustic_spaces/gui/inspector.py
msgid "Extent"
msgstr "Omvang"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Where the ground ends, from its south-west corner (x, y) to its north-east "
"one, in the units the title shows; off: the margin round the buildings, "
"barriers and model, or the whole terrain. Past the ground's edge, sound "
"leaves the scene as if the ground went on"
msgstr ""
"Waar de grond eindigt, van de zuidwesthoek (x, y) tot de noordoosthoek, in "
"de eenheden die in de titel staan; uit: de marge rond de gebouwen, "
"geluidsschermen en het model, of het hele reliëf. Voorbij de rand van de "
"grond verlaat het geluid de scène alsof de grond doorliep"

#: acoustic_spaces/gui/inspector.py
msgid "x where the ground starts (its west edge)"
msgstr "x waar de grond begint (de westrand)"

#: acoustic_spaces/gui/inspector.py
msgid "y where the ground starts (its south edge)"
msgstr "y waar de grond begint (de zuidrand)"

#: acoustic_spaces/gui/inspector.py
msgid "x where the ground ends (its east edge)"
msgstr "x waar de grond eindigt (de oostrand)"

#: acoustic_spaces/gui/inspector.py
msgid "y where the ground ends (its north edge)"
msgstr "y waar de grond eindigt (de noordrand)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Where the ground ends: past it, sound leaves the scene as if the ground went "
"on"
msgstr ""
"Waar de grond eindigt: daarbuiten verlaat het geluid de scène alsof de grond "
"doorliep"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The terrain the ground follows: its heights on a grid, from a file or given "
"in the scene file, sampled over the ground's extent"
msgstr ""
"Het reliëf dat de grond volgt: de hoogten op een raster, uit een bestand of "
"opgegeven in het scènebestand, bemonsterd over de omvang van de grond"

#: acoustic_spaces/gui/inspector.py
msgid "Terrain from a file…"
msgstr "Reliëf uit een bestand…"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Make the ground follow the heights in a file: an Esri ASCII grid (.asc) or x "
"y z points on a regular grid (.xyz, .txt, .csv), in the units the title "
"shows. The terrain sets the ground's size, unless an extent inside it is set"
msgstr ""
"De grond de hoogten uit een bestand laten volgen: een Esri ASCII-raster "
"(.asc) of x y z-punten op een regelmatig raster (.xyz, .txt, .csv), in de "
"eenheden die in de titel staan. Het reliëf bepaalt de grootte van de grond, "
"tenzij een omvang erbinnen is ingesteld"

#: acoustic_spaces/gui/inspector.py
msgid "Remove terrain"
msgstr "Reliëf verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Flatten the ground again, at the ground height, with the margin round the "
"parts"
msgstr ""
"De grond weer vlak maken, op de grondhoogte, met de marge rond de onderdelen"

#: acoustic_spaces/gui/inspector.py
msgid "Buildings"
msgstr "Gebouwen"

#: acoustic_spaces/gui/inspector.py
msgid "Corners"
msgstr "Hoeken"

#: acoustic_spaces/gui/inspector.py
msgid "The building's name; its surfaces are named after it"
msgstr "De naam van het gebouw; de oppervlakken ervan zijn ernaar genoemd"

#: acoustic_spaces/gui/inspector.py
msgid "How high the building is, ground to roof, in the units the title shows"
msgstr ""
"De hoogte van het gebouw, van grond tot dak, in de eenheden die in de titel "
"staan"

#: acoustic_spaces/gui/inspector.py
msgid "How many corners the building's footprint has (as drawn in the plan)"
msgstr ""
"Hoeveel hoeken het grondvlak van het gebouw heeft (zoals getekend in de "
"plattegrond)"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected building, or the last one when none is selected"
msgstr ""
"Het geselecteerde gebouw verwijderen, of het laatste als er geen is "
"geselecteerd"

#: acoustic_spaces/gui/inspector.py
msgid "Add building"
msgstr "Gebouw toevoegen"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Draw a building's footprint in the plan, corner by corner, and close it on "
"the first corner; it rises {height:g} m from the ground, to change in the "
"table"
msgstr ""
"Het grondvlak van een gebouw in de plattegrond hoek voor hoek tekenen en bij "
"de eerste hoek sluiten; het rijst {height:g} m boven de grond uit, te "
"wijzigen in de tabel"

#: acoustic_spaces/gui/inspector.py
msgid "Remove building"
msgstr "Gebouw verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid "Barriers"
msgstr "Geluidsschermen"

#: acoustic_spaces/gui/inspector.py
msgid "Points"
msgstr "Punten"

#: acoustic_spaces/gui/inspector.py
msgid "The barrier's name, which its surfaces carry"
msgstr "De naam van het geluidsscherm, die de oppervlakken ervan dragen"

#: acoustic_spaces/gui/inspector.py
msgid "How high the barrier is over the ground, in the units the title shows"
msgstr ""
"De hoogte van het geluidsscherm boven de grond, in de eenheden die in de "
"titel staan"

#: acoustic_spaces/gui/inspector.py
msgid "How many points the barrier's path has (as drawn in the plan)"
msgstr ""
"Hoeveel punten het tracé van het geluidsscherm heeft (zoals getekend in de "
"plattegrond)"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected barrier, or the last one when none is selected"
msgstr ""
"Het geselecteerde geluidsscherm verwijderen, of het laatste als er geen is "
"geselecteerd"

#: acoustic_spaces/gui/inspector.py
msgid "Add barrier"
msgstr "Geluidsscherm toevoegen"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Draw a barrier's path in the plan, point by point, and finish it with Enter "
"or a double click; it stands {height:g} m high, to change in the table"
msgstr ""
"Het tracé van een geluidsscherm in de plattegrond punt voor punt tekenen en "
"afsluiten met Enter of een dubbelklik; het is {height:g} m hoog, te wijzigen "
"in de tabel"

#: acoustic_spaces/gui/inspector.py
msgid "Remove barrier"
msgstr "Geluidsscherm verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid "Vegetation"
msgstr "Vegetatie"

#: acoustic_spaces/gui/inspector.py
msgid "Shape"
msgstr "Vorm"

#: acoustic_spaces/gui/inspector.py
msgid "Plants"
msgstr "Planten"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The name of the tree, hedge or belt of trees: no surface, a volume that "
"sound passes through, losing some of itself"
msgstr ""
"De naam van de boom, de haag of de bomenstrook: geen oppervlak, maar een "
"volume waar het geluid doorheen gaat en waarbij het een deel van zichzelf "
"verliest"

#: acoustic_spaces/gui/inspector.py
msgid "How high its top is over the ground, in the units the title shows"
msgstr ""
"De hoogte van de bovenkant boven de grond, in de eenheden die in de titel "
"staan"

#: acoustic_spaces/gui/inspector.py
msgid ""
"A belt of trees (a footprint raised from the ground), a hedge (a path of a "
"width) or a lone tree's crown, as drawn in the plan"
msgstr ""
"Een bomenstrook (een grondvlak dat vanaf de grond is opgetrokken), een haag "
"(een tracé met een breedte) of de kroon van een losse boom, zoals getekend "
"in de plattegrond"

#: acoustic_spaces/gui/inspector.py
msgid ""
"What fills it: foliage, which takes so many dB per metre from sound passing "
"through, or leaves by their area and width, which work that out for "
"themselves; and stems, which scatter it sideways"
msgstr ""
"Wat het vult: gebladerte, dat zoveel dB per meter wegneemt van het geluid "
"dat erdoor gaat, of bladeren naar oppervlak en breedte, die dat zelf "
"bepalen; en stammen, die het zijwaarts verstrooien"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected vegetation, or the last one when none is selected"
msgstr ""
"De geselecteerde vegetatie verwijderen, of de laatste als er geen is "
"geselecteerd"

#: acoustic_spaces/gui/inspector.py
msgid "Add vegetation"
msgstr "Vegetatie toevoegen"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Draw the shape chosen beside in the plan: a belt's footprint closed on its "
"first corner, a hedge's path finished with Enter, or a tree's place with one "
"click; dense foliage, its height to change in the table and the rest in the "
"scene file"
msgstr ""
"De hiernaast gekozen vorm in de plattegrond tekenen: het grondvlak van een "
"strook, gesloten bij de eerste hoek, het tracé van een haag, afgesloten met "
"Enter, of de plaats van een boom met één klik; dicht gebladerte, de hoogte "
"te wijzigen in de tabel en de rest in het scènebestand"

#: acoustic_spaces/gui/inspector.py
msgid "Remove vegetation"
msgstr "Vegetatie verwijderen"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"What to draw next: a belt of trees (its footprint, corner by corner), a "
"hedge (its path, point by point, {width:g} m wide) or a lone tree (one "
"click, its crown {crown:g} m across)"
msgstr ""
"Wat hierna wordt getekend: een bomenstrook (het grondvlak, hoek voor hoek), "
"een haag (het tracé, punt voor punt, {width:g} m breed) of een losse boom "
"(één klik, met een kroon van {crown:g} m doorsnede)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The map the buildings marked 'from the buildings file' come from: a GeoJSON "
"file of footprints, each raised to the height a property of it gives (or one "
"height for all) and named by another"
msgstr ""
"De kaart waar de gebouwen met de markering 'uit het gebouwenbestand' vandaan "
"komen: een GeoJSON-bestand met grondvlakken, elk opgetrokken tot de hoogte "
"die een eigenschap ervan opgeeft (of één hoogte voor alle) en genoemd naar "
"een andere"

#: acoustic_spaces/gui/inspector.py
msgid "Buildings from a map…"
msgstr "Gebouwen uit een kaart…"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Add the buildings of a GeoJSON file of footprints, on a plane in the units "
"the title shows (not longitude and latitude), each as high as a property of "
"it says; they join the ones drawn here"
msgstr ""
"De gebouwen van een GeoJSON-bestand met grondvlakken toevoegen, in een vlak "
"in de eenheden die in de titel staan (geen lengte- en breedtegraden), elk zo "
"hoog als een eigenschap ervan zegt; ze komen bij de hier getekende"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the map's buildings"
msgstr "Gebouwen van de kaart verwijderen"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Drop the map and every building that came from it; the buildings drawn here "
"stay"
msgstr ""
"De kaart en alle gebouwen die eruit kwamen verwijderen; de hier getekende "
"gebouwen blijven"

#: acoustic_spaces/gui/inspector.py
msgid "Ground zones"
msgstr "Grondzones"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The zone's name: a part of the ground (a road, a lawn) whose surfaces carry "
"it, to give it a material of its own"
msgstr ""
"De naam van de zone: een deel van de grond (een weg, een grasveld) waarvan "
"de vlakken hem dragen, om het een eigen materiaal te geven"

#: acoustic_spaces/gui/inspector.py
msgid "How many corners the zone's outline has (as drawn in the plan)"
msgstr ""
"Hoeveel hoeken de omtrek van de zone heeft (zoals getekend in de plattegrond)"

