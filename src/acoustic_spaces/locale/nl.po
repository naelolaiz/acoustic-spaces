#. Translators: a background task such as "Simulating hall…", then how long it has run so far.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task} {time:.0f} s"
msgstr "{task} {time:.0f} s"

#. Translators: the task and its time, then what it does now.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task}: {step}"
msgstr "{task}: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Now: {step}"
msgstr "Nu: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Running for {time:.0f} s"
msgstr "Loopt al {time:.0f} s"

#
#: acoustic_spaces/gui/activity.py
msgid ""
"Cancel, or Simulation > Cancel (Shift+F5), stops it: a run at its next "
"stage, a demo at once"
msgstr ""
"Annuleren, of Simulatie > Annuleren (Shift+F5), stopt deze: een berekening "
"bij de volgende stap, een demo meteen"

#: acoustic_spaces/gui/app.py
msgid "Acoustic Spaces editor"
msgstr "Acoustic Spaces-editor"

#: acoustic_spaces/gui/app.py
msgid "Scenes (*.yaml *.yml)"
msgstr "Scènes (*.yaml *.yml)"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New building with {count} corners, {height:g} m high; change its height "
"under Geometry."
msgstr ""
"Nieuw gebouw met {count} hoeken, {height:g} m hoog; de hoogte wijzigen onder "
"Geometrie."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New barrier along {count} points, {height:g} m high; change its height under "
"Geometry."
msgstr ""
"Nieuw geluidsscherm met {count} punten, {height:g} m hoog; de hoogte "
"wijzigen onder Geometrie."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New belt of trees with {count} corners, {height:g} m high, with dense "
"foliage; change its height under Geometry and the rest in the scene file."
msgstr ""
"Nieuwe bomenstrook met {count} hoeken, {height:g} m hoog, met dicht "
"gebladerte; de hoogte wijzigen onder Geometrie en de rest in het "
"scènebestand."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New hedge along {count} points, {width:g} m wide and {height:g} m high, with "
"dense foliage; change its height under Geometry and the rest in the scene "
"file."
msgstr ""
"Nieuwe haag met {count} punten, {width:g} m breed en {height:g} m hoog, met "
"dicht gebladerte; de hoogte wijzigen onder Geometrie en de rest in het "
"scènebestand."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New tree {height:g} m high, its crown {crown_diameter:g} m across from "
"{base:g} m up, with dense foliage; change its height under Geometry and the "
"rest in the scene file."
msgstr ""
"Nieuwe boom van {height:g} m hoog, met een kroon van {crown_diameter:g} m "
"doorsnede vanaf {base:g} m hoogte en dicht gebladerte; de hoogte wijzigen "
"onder Geometrie en de rest in het scènebestand."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New ground zone with {count} corners; give its surface a material of its own "
"in the scene tree."
msgstr ""
"Nieuwe grondzone met {count} hoeken; geef het vlak ervan een eigen materiaal "
"in de scèneboom."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New weather zone with {count} corners; choose it under Weather of in the "
"scene's entry to give it wind and temperature of its own."
msgstr ""
"Nieuwe weerzone met {count} hoeken; kies die onder Weer van in het onderdeel "
"van de scène om haar een eigen wind en temperatuur te geven."

#. Translators: {patterns} is the list of model file patterns, such as *.obj *.dxf.
#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Models ({patterns})"
msgstr "Modellen ({patterns})"

#: acoustic_spaces/gui/app.py
msgid "glTF binary (*.glb)"
msgstr "Binair glTF (*.glb)"

#: acoustic_spaces/gui/app.py
msgid "Pack (*.zip)"
msgstr "Pakket (*.zip)"

#. Translators: two file types of a save dialog, kept apart by ;; (keep it).
#: acoustic_spaces/gui/app.py
msgid "PNG picture (*.png);;JSON, every map (*.json)"
msgstr "PNG-afbeelding (*.png);;JSON, alle kaarten (*.json)"

#: acoustic_spaces/gui/app.py
msgid "3D view"
msgstr "3D-weergave"

#: acoustic_spaces/gui/app.py
msgid "Plan"
msgstr "Plattegrond"

#: acoustic_spaces/gui/app.py
msgid "The room in 3D: click to select, drag sources and listeners"
msgstr ""
"De ruimte in 3D: klikken om te selecteren, bronnen en ontvangers verslepen"

#: acoustic_spaces/gui/app.py
msgid "The room from above: draw floor plans, drag corners and points"
msgstr ""
"De ruimte van bovenaf: plattegronden tekenen, hoeken en punten verslepen"

#: acoustic_spaces/gui/app.py
msgid "Properties"
msgstr "Eigenschappen"

#: acoustic_spaces/gui/app.py
msgid "Results"
msgstr "Resultaten"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Coverage map"
msgstr "Dekkingskaart"

#: acoustic_spaces/gui/app.py
msgid "Messages"
msgstr "Meldingen"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/demo_dialog.py
msgid "Movement"
msgstr "Beweging"

#: acoustic_spaces/gui/app.py
msgid "Scene YAML"
msgstr "Scène-YAML"

#: acoustic_spaces/gui/app.py
msgid ""
"What plays through the room: the recording, and the source and listener of "
"the response it plays through"
msgstr ""
"Wat door de ruimte wordt afgespeeld: de opname en de bron en ontvanger van "
"de gebruikte respons"

#: acoustic_spaces/gui/app.py
msgid "&New box room…"
msgstr "&Nieuwe rechthoekige ruimte…"

#: acoustic_spaces/gui/app.py
msgid "Start a new scene in a box-shaped room"
msgstr "Een nieuwe scène in een rechthoekige ruimte maken"

#: acoustic_spaces/gui/app.py
msgid "New from &model file…"
msgstr "Nieuw uit &modelbestand…"

#: acoustic_spaces/gui/app.py
msgid "Start from a model file (OBJ, DXF, glTF, STL, IFC, Collada or SketchUp)"
msgstr ""
"Beginnen met een modelbestand (OBJ, DXF, glTF, STL, IFC, Collada of SketchUp)"

#: acoustic_spaces/gui/app.py
msgid "New room from a &floor plan…"
msgstr "Nieuwe ruimte uit &plattegrond…"

#: acoustic_spaces/gui/app.py
msgid "Draw the floor plan of a new room, corner by corner"
msgstr "De plattegrond van een nieuwe ruimte hoek voor hoek tekenen"

#: acoustic_spaces/gui/app.py
msgid "New o&utdoor scene…"
msgstr "Nieuwe b&uitenscène…"

#: acoustic_spaces/gui/app.py
msgid ""
"Start a new scene on open ground, to draw buildings, barriers, vegetation "
"and ground zones on, or to set a terrain and buildings from a map"
msgstr ""
"Een nieuwe scène op open grond maken, om er gebouwen, geluidsschermen, "
"vegetatie en grondzones op te tekenen, of er een reliëf en gebouwen uit een "
"kaart op te zetten"

#: acoustic_spaces/gui/app.py
msgid "&Open…"
msgstr "&Openen…"

#: acoustic_spaces/gui/app.py
msgid "Open a scene file (YAML)"
msgstr "Een scènebestand openen (YAML)"

#: acoustic_spaces/gui/app.py
msgid "&Save"
msgstr "Op&slaan"

#: acoustic_spaces/gui/app.py
msgid "Save the scene; an example asks where to keep your copy"
msgstr ""
"De scène opslaan; bij een voorbeeld wordt gevraagd waar de eigen kopie moet "
"worden bewaard"

#: acoustic_spaces/gui/app.py
msgid "Save &as…"
msgstr "Opslaan &als…"

#: acoustic_spaces/gui/app.py
msgid "Save the scene in another file"
msgstr "De scène in een ander bestand opslaan"

#: acoustic_spaces/gui/app.py
msgid "&Export results…"
msgstr "&Resultaten exporteren…"

#: acoustic_spaces/gui/app.py
msgid ""
"Write every response of the last run to a folder: a WAV file per output "
"format and parameters.json, as acoustic-spaces simulate does"
msgstr ""
"Alle responsen van de laatste berekening naar een map schrijven: een "
"WAV-bestand per uitvoerformaat en parameters.json, zoals acoustic-spaces "
"simulate"

#: acoustic_spaces/gui/app.py
msgid "Export to &Blender…"
msgstr "Naar &Blender exporteren…"

#: acoustic_spaces/gui/app.py
msgid "The room, and the reflection paths on show, as glTF"
msgstr "De ruimte en de getoonde reflectiepaden als glTF exporteren"

#: acoustic_spaces/gui/app.py
msgid "Export &particle animation to Blender…"
msgstr "&Deeltjesanimatie naar Blender exporteren…"

#: acoustic_spaces/gui/app.py
msgid ""
"Sound particles from the selected source (or the first) as a glTF animation: "
"as much of the sound, as slowly and as many particles as you choose"
msgstr ""
"Geluidsdeeltjes van de geselecteerde bron (of de eerste) als glTF-animatie "
"exporteren: zoveel van het geluid, zo langzaam en zoveel deeltjes als je "
"kiest"

#: acoustic_spaces/gui/app.py
msgid "Pac&k for another computer…"
msgstr "&Inpakken voor een andere computer…"

#: acoustic_spaces/gui/app.py
msgid ""
"Put the scene and every file it names in one zip file, to run on a server or "
"a cloud job as acoustic-spaces pack does; nothing is uploaded"
msgstr ""
"Zet de scène en elk bestand dat ze noemt in één zipbestand, om te berekenen "
"op een server of in een cloudtaak, zoals acoustic-spaces pack; er wordt "
"niets geüpload"

#: acoustic_spaces/gui/app.py
msgid "&Quit"
msgstr "A&fsluiten"

#: acoustic_spaces/gui/app.py
msgid "Close the editor; it asks about unsaved changes"
msgstr ""
"De editor sluiten; bij niet-opgeslagen wijzigingen wordt om bevestiging "
"gevraagd"

#. Translators: {edit} says what the last edit did, such as "move the source".
#: acoustic_spaces/gui/app.py
msgid "&Undo"
msgstr "&Ongedaan maken"

#: acoustic_spaces/gui/app.py
msgid "Take back the last change"
msgstr "De laatste wijziging ongedaan maken"

#: acoustic_spaces/gui/app.py
msgid "&Redo"
msgstr "Opnieuw &uitvoeren"

#: acoustic_spaces/gui/app.py
msgid "Make the change Undo took back"
msgstr "De ongedaan gemaakte wijziging opnieuw uitvoeren"

#: acoustic_spaces/gui/app.py
msgid "Place &source"
msgstr "&Bron plaatsen"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a source there"
msgstr ""
"Op een vloer of wand in de 3D-weergave klikken om daar een bron te plaatsen"

#: acoustic_spaces/gui/app.py
msgid "Place &listener"
msgstr "Ont&vanger plaatsen"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a listener there"
msgstr ""
"Op een vloer of wand in de 3D-weergave klikken om daar een ontvanger te "
"plaatsen"

#: acoustic_spaces/gui/app.py
msgid "&Draw floor plan"
msgstr "&Plattegrond tekenen"

#: acoustic_spaces/gui/app.py
msgid "Draw a new floor plan in the plan view; it replaces the room"
msgstr ""
"Een nieuwe plattegrond in de plattegrondweergave tekenen; deze vervangt de "
"ruimte"

#: acoustic_spaces/gui/app.py
msgid "Add &material from the database…"
msgstr "&Materiaal uit database toevoegen…"

#: acoustic_spaces/gui/app.py
msgid "A material of the built-in database of absorption coefficients"
msgstr ""
"Een materiaal uit de ingebouwde database met absorptiecoëfficiënten toevoegen"

#: acoustic_spaces/gui/app.py
msgid "Add material from a &library…"
msgstr "Materiaal uit bib&liotheek toevoegen…"

#: acoustic_spaces/gui/app.py
msgid ""
"A material of a CATT-Acoustic (ABS lines) or ODEON (.Li8) material library"
msgstr ""
"Een materiaal uit een CATT-Acoustic-bibliotheek (ABS-regels) of "
"ODEON-bibliotheek (.Li8) toevoegen"

#: acoustic_spaces/gui/app.py
msgid "Re&move selected"
msgstr "&Selectie verwijderen"

#: acoustic_spaces/gui/app.py
msgid ""
"Remove the selected source, listener or material (Delete, in the scene tree "
"or a view)"
msgstr ""
"De geselecteerde bron, ontvanger of het materiaal verwijderen (Delete, in de "
"scèneboom of een weergave)"

#: acoustic_spaces/gui/app.py
msgid "&Reset camera"
msgstr "&Camera herstellen"

#: acoustic_spaces/gui/app.py
msgid "Show the whole room in the 3D view from the usual angle"
msgstr "De hele ruimte in de 3D-weergave vanuit de gebruikelijke hoek tonen"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "&3D-weergave"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "De ruimte in 3D tonen"

#: acoustic_spaces/gui/app.py
msgid "P&lan"
msgstr "&Plattegrond"

#: acoustic_spaces/gui/app.py
msgid "Show the room from above, to draw and change floor plans"
msgstr "De ruimte van bovenaf tonen om plattegronden te tekenen en te bewerken"

#: acoustic_spaces/gui/app.py
msgid "Edit &movement…"
msgstr "Bew&eging bewerken…"

#: acoustic_spaces/gui/app.py
msgid ""
"Open the Movement panel: where the selected source or listener is and how it "
"faces at each time of a movement, with a timeline every mover is previewed "
"along"
msgstr ""
"Het paneel Beweging openen: waar de geselecteerde bron of ontvanger op elk "
"moment van een beweging is en waarheen die kijkt, met een tijdlijn waarlangs "
"alles wat beweegt wordt voorvertoond"

#: acoustic_spaces/gui/app.py
msgid "Show reflection &paths"
msgstr "&Reflectiepaden tonen"

#: acoustic_spaces/gui/app.py
msgid ""
"Draw the early reflection paths of the source and listener the Results panel "
"shows, coloured by order"
msgstr ""
"De vroege reflectiepaden van de bron en ontvanger in het resultatenpaneel "
"tekenen, gekleurd per orde"

#: acoustic_spaces/gui/app.py
msgid "Show &leaks"
msgstr "&Lekken tonen"

#: acoustic_spaces/gui/app.py
msgid ""
"Trace rays from the sources and show where they escape from a model that is "
"not closed"
msgstr ""
"Stralen vanuit de bronnen volgen en tonen waar ze uit een niet-gesloten "
"model ontsnappen"

#: acoustic_spaces/gui/app.py
msgid "Show &wind"
msgstr "&Wind tonen"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, draw the wind in the 3D view and the plan: arrows the way it "
"blows, as long as it is strong, at the height the scene gives its speed at, "
"and each weather zone with its wind"
msgstr ""
"Buiten de wind in de 3D-weergave en de plattegrond tekenen: pijlen in de "
"richting waarin hij waait, zo lang als hij sterk is, op de hoogte waarvoor "
"de scène zijn snelheid geeft, en elke weerzone met haar wind"

