#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "The share of the {period} this weather class holds (%)"
msgstr ""
"La quota del periodo {period} in cui vale questa classe meteorologica (%)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Surface area: {area:,.1f} m²"
msgstr "Area superficiale: {area:,.1f} m²"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³ in {count} room ({each} m³)"
msgid_plural "Volume: {volume:,.1f} m³ in {count} rooms ({each} m³)"
msgstr[0] "Volume: {volume:,.1f} m³ in {count} ambiente ({each} m³)"
msgstr[1] "Volume: {volume:,.1f} m³ in {count} ambienti ({each} m³)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³"
msgstr "Volume: {volume:,.1f} m³"

#: acoustic_spaces/gui/inspector.py
msgid "Volume: model not closed"
msgstr "Volume: modello non chiuso"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Reverberation time at {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s "
"(Sabine)"
msgstr ""
"Tempo di riverberazione a {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s "
"(Sabine)"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/yaml_panel.py
#, python-brace-format
msgid "Problem: {problem}"
msgstr "Problema: {problem}"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/yaml_panel.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "Avviso: {warning}"

#: acoustic_spaces/gui/inspector.py
msgid "change recording"
msgstr "cambia la registrazione"

#: acoustic_spaces/gui/inspector.py
msgid "rename scene"
msgstr "rinomina scena"

#: acoustic_spaces/gui/inspector.py
msgid "change default material"
msgstr "modifica materiale predefinito"

#: acoustic_spaces/gui/inspector.py
msgid "change air"
msgstr "modifica aria"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather"
msgstr "modifica il tempo"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather zone"
msgstr "cambia la zona meteorologica"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather class"
msgstr "cambia la classe meteorologica"

#: acoustic_spaces/gui/inspector.py
msgid "add weather class"
msgstr "aggiungi classe meteorologica"

#: acoustic_spaces/gui/inspector.py
msgid "remove weather class"
msgstr "rimuovi classe meteorologica"

#: acoustic_spaces/gui/inspector.py
msgid "a share of the time is a number from 0 to 100 %"
msgstr "una quota del tempo è un numero da 0 a 100 %"

#: acoustic_spaces/gui/inspector.py
msgid "remove weather zone"
msgstr "rimuovi zona meteorologica"

#: acoustic_spaces/gui/inspector.py
msgid "change the eddies"
msgstr "cambiare la turbolenza"

#: acoustic_spaces/gui/inspector.py
msgid "change the wind and temperature"
msgstr "modifica vento e temperatura"

#: acoustic_spaces/gui/inspector.py
msgid "remove the measured profile"
msgstr "rimuovi il profilo misurato"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Wind and temperature of {name}"
msgstr "Vento e temperatura di {name}"

#: acoustic_spaces/gui/inspector.py
msgid "Box"
msgstr "Ambiente rettangolare"

#: acoustic_spaces/gui/inspector.py
msgid "Length (x)"
msgstr "Lunghezza (x)"

#: acoustic_spaces/gui/inspector.py
msgid "Width (y)"
msgstr "Larghezza (y)"

#: acoustic_spaces/gui/inspector.py
msgid "Height (z)"
msgstr "Altezza (z)"

#: acoustic_spaces/gui/inspector.py
msgid "How long the room is along x, in the units the title shows"
msgstr "La lunghezza dell'ambiente lungo x, nelle unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid "How wide the room is along y, in the units the title shows"
msgstr "La larghezza dell'ambiente lungo y, nelle unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid "How high the room is, floor to ceiling, in the units the title shows"
msgstr ""
"L'altezza dell'ambiente, dal pavimento al soffitto, nelle unità indicate nel "
"titolo"

#: acoustic_spaces/gui/inspector.py
msgid "Floor plan"
msgstr "Pianta"

#. Translators: {axis} is x or y.
#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"The {axis} of each corner, in the units the title shows; the corners go "
"round the room in turn"
msgstr ""
"La coordinata {axis} di ogni vertice, nelle unità indicate nel titolo; i "
"vertici seguono il perimetro dell'ambiente"

#: acoustic_spaces/gui/inspector.py
msgid "Add corner"
msgstr "Aggiungi vertice"

#: acoustic_spaces/gui/inspector.py acoustic_spaces/gui/plan_view.py
msgid "Remove corner"
msgstr "Rimuovi vertice"

#: acoustic_spaces/gui/inspector.py
msgid "Add a corner halfway between the last corner and the first"
msgstr "Aggiungere un vertice a metà tra l'ultimo e il primo"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected corner, or the last one when none is selected"
msgstr "Rimuovere il vertice selezionato o l'ultimo se nessuno è selezionato"

#: acoustic_spaces/gui/inspector.py
msgid "The model file the room comes from"
msgstr "Il file di modello da cui proviene l'ambiente"

#: acoustic_spaces/gui/inspector.py
msgid "Choose another file…"
msgstr "Scegli un altro file…"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Take the room from another model file; the materials and their assignments "
"stay"
msgstr ""
"Importare l'ambiente da un altro file di modello; i materiali e le loro "
"assegnazioni vengono mantenuti"

#: acoustic_spaces/gui/inspector.py
msgid "file default"
msgstr "predefinite del file"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The unit the model's lengths are in; file default: the units a DXF, IFC or "
"Collada file records, else metres"
msgstr ""
"L'unità delle lunghezze del modello; predefinite del file: le unità "
"registrate in un file DXF, IFC o Collada, altrimenti metri"

#: acoustic_spaces/gui/inspector.py
msgid "format default"
msgstr "predefinito del formato"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The axis that points up in the model; format default: y for glTF and "
"SketchUp, the one a Collada file records, z for the others (Blender's OBJ "
"export writes y up)"
msgstr ""
"L'asse verticale del modello; predefinito del formato: y per glTF e "
"SketchUp, quello registrato in un file Collada, z per gli altri "
"(l'esportazione OBJ di Blender usa y come asse verticale)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The room of an IFC model to take on its own, from its space boundaries; "
"every element reads walls as solids, with both sides"
msgstr ""
"L'ambiente di un modello IFC da importare separatamente, tramite i confini "
"dello spazio; tutti gli elementi legge le pareti come solidi, con entrambi i "
"lati"

#: acoustic_spaces/gui/inspector.py
msgid "Units"
msgstr "Unità"

#: acoustic_spaces/gui/inspector.py
msgid "Up axis"
msgstr "Asse verticale"

#: acoustic_spaces/gui/inspector.py
msgid "IFC room"
msgstr "Ambiente IFC"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The height (z) of the flat ground, or added to the terrain's heights, in the "
"units the title shows"
msgstr ""
"L'altezza (z) del terreno piano, o sommata alle quote del rilievo, nelle "
"unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid ""
"How far the ground reaches past the buildings, barriers and model, unless "
"its extent is set or a terrain sets its size, and how high the sky is over "
"the highest of them, unless the sky is set; in the units the title shows"
msgstr ""
"Fin dove si estende il terreno oltre gli edifici, le barriere e il modello, "
"se la sua estensione non è impostata o un rilievo non ne fissa le "
"dimensioni, e a che altezza si trova il cielo sopra il più alto di essi, se "
"il cielo non è impostato; nelle unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid ""
"How high the open sky lies over the ground, in the units the title shows; "
"auto: the margin over the highest building, barrier or model part. Sound "
"that reaches the sky leaves the scene"
msgstr ""
"A che altezza si trova il cielo aperto sopra il terreno, nelle unità "
"indicate nel titolo; automatico: il margine sopra l'edificio, la barriera o "
"la parte del modello più alta. Il suono che raggiunge il cielo esce dalla "
"scena"

#: acoustic_spaces/gui/inspector.py
msgid "Ground height"
msgstr "Altezza del terreno"

#: acoustic_spaces/gui/inspector.py
msgid "Margin"
msgstr "Margine"

#: acoustic_spaces/gui/inspector.py
msgid "Sky"
msgstr "Cielo"

#: acoustic_spaces/gui/inspector.py
msgid "Extent"
msgstr "Estensione"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Where the ground ends, from its south-west corner (x, y) to its north-east "
"one, in the units the title shows; off: the margin round the buildings, "
"barriers and model, or the whole terrain. Past the ground's edge, sound "
"leaves the scene as if the ground went on"
msgstr ""
"Dove finisce il terreno, dal suo angolo sud-ovest (x, y) a quello nord-est, "
"nelle unità indicate nel titolo; disattivato: il margine intorno a edifici, "
"barriere e modello, o l'intero rilievo. Oltre il bordo del terreno, il suono "
"esce dalla scena come se il terreno continuasse"

#: acoustic_spaces/gui/inspector.py
msgid "x where the ground starts (its west edge)"
msgstr "x dove inizia il terreno (il suo bordo ovest)"

#: acoustic_spaces/gui/inspector.py
msgid "y where the ground starts (its south edge)"
msgstr "y dove inizia il terreno (il suo bordo sud)"

#: acoustic_spaces/gui/inspector.py
msgid "x where the ground ends (its east edge)"
msgstr "x dove finisce il terreno (il suo bordo est)"

#: acoustic_spaces/gui/inspector.py
msgid "y where the ground ends (its north edge)"
msgstr "y dove finisce il terreno (il suo bordo nord)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Where the ground ends: past it, sound leaves the scene as if the ground went "
"on"
msgstr ""
"Dove finisce il terreno: oltre, il suono esce dalla scena come se il terreno "
"continuasse"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The terrain the ground follows: its heights on a grid, from a file or given "
"in the scene file, sampled over the ground's extent"
msgstr ""
"Il rilievo che il terreno segue: le sue altezze su una griglia, da un file o "
"date nel file di scena, campionate sull'estensione del terreno"

#: acoustic_spaces/gui/inspector.py
msgid "Terrain from a file…"
msgstr "Rilievo da un file…"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Make the ground follow the heights in a file: an Esri ASCII grid (.asc) or x "
"y z points on a regular grid (.xyz, .txt, .csv), in the units the title "
"shows. The terrain sets the ground's size, unless an extent inside it is set"
msgstr ""
"Far seguire al terreno le altezze di un file: una griglia Esri ASCII (.asc) "
"o punti x y z su una griglia regolare (.xyz, .txt, .csv), nelle unità "
"indicate nel titolo. Il rilievo fissa le dimensioni del terreno, a meno che "
"non sia impostata un'estensione al suo interno"

#: acoustic_spaces/gui/inspector.py
msgid "Remove terrain"
msgstr "Rimuovi rilievo"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Flatten the ground again, at the ground height, with the margin round the "
"parts"
msgstr ""
"Riappianare il terreno, all'altezza del terreno, con il margine intorno agli "
"elementi"

#: acoustic_spaces/gui/inspector.py
msgid "Buildings"
msgstr "Edifici"

#: acoustic_spaces/gui/inspector.py
msgid "Corners"
msgstr "Vertici"

#: acoustic_spaces/gui/inspector.py
msgid "The building's name; its surfaces are named after it"
msgstr "Il nome dell'edificio; le sue superfici prendono il suo nome"

#: acoustic_spaces/gui/inspector.py
msgid "How high the building is, ground to roof, in the units the title shows"
msgstr ""
"L'altezza dell'edificio, dal terreno alla copertura, nelle unità indicate "
"nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid "How many corners the building's footprint has (as drawn in the plan)"
msgstr ""
"Quanti vertici ha l'impronta dell'edificio (come disegnata nella pianta)"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected building, or the last one when none is selected"
msgstr "Rimuovere l'edificio selezionato o l'ultimo se nessuno è selezionato"

#: acoustic_spaces/gui/inspector.py
msgid "Add building"
msgstr "Aggiungi edificio"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Draw a building's footprint in the plan, corner by corner, and close it on "
"the first corner; it rises {height:g} m from the ground, to change in the "
"table"
msgstr ""
"Disegnare l'impronta di un edificio nella pianta, vertice per vertice, e "
"chiuderla sul primo; si alza di {height:g} m dal terreno, da modificare "
"nella tabella"

#: acoustic_spaces/gui/inspector.py
msgid "Remove building"
msgstr "Rimuovi edificio"

#: acoustic_spaces/gui/inspector.py
msgid "Barriers"
msgstr "Barriere acustiche"

#: acoustic_spaces/gui/inspector.py
msgid "Points"
msgstr "Punti"

#: acoustic_spaces/gui/inspector.py
msgid "The barrier's name, which its surfaces carry"
msgstr "Il nome della barriera, che le sue superfici portano"

#: acoustic_spaces/gui/inspector.py
msgid "How high the barrier is over the ground, in the units the title shows"
msgstr ""
"L'altezza della barriera sopra il terreno, nelle unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid "How many points the barrier's path has (as drawn in the plan)"
msgstr ""
"Quanti punti ha il tracciato della barriera (come disegnato nella pianta)"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected barrier, or the last one when none is selected"
msgstr "Rimuovere la barriera selezionata o l'ultima se nessuna è selezionata"

#: acoustic_spaces/gui/inspector.py
msgid "Add barrier"
msgstr "Aggiungi barriera"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Draw a barrier's path in the plan, point by point, and finish it with Enter "
"or a double click; it stands {height:g} m high, to change in the table"
msgstr ""
"Disegnare il tracciato di una barriera nella pianta, punto per punto, e "
"terminarlo con Invio o un doppio clic; è alta {height:g} m, da modificare "
"nella tabella"

#: acoustic_spaces/gui/inspector.py
msgid "Remove barrier"
msgstr "Rimuovi barriera"

#: acoustic_spaces/gui/inspector.py
msgid "Vegetation"
msgstr "Vegetazione"

#: acoustic_spaces/gui/inspector.py
msgid "Shape"
msgstr "Forma"

#: acoustic_spaces/gui/inspector.py
msgid "Plants"
msgstr "Piante"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The name of the tree, hedge or belt of trees: no surface, a volume that "
"sound passes through, losing some of itself"
msgstr ""
"Il nome dell'albero, della siepe o della fascia di alberi: non una "
"superficie, ma un volume che il suono attraversa, perdendone una parte"

#: acoustic_spaces/gui/inspector.py
msgid "How high its top is over the ground, in the units the title shows"
msgstr ""
"L'altezza della sua sommità sopra il terreno, nelle unità indicate nel titolo"

#: acoustic_spaces/gui/inspector.py
msgid ""
"A belt of trees (a footprint raised from the ground), a hedge (a path of a "
"width) or a lone tree's crown, as drawn in the plan"
msgstr ""
"Una fascia di alberi (un'impronta sollevata dal terreno), una siepe (un "
"tracciato con una larghezza) o la chioma di un albero isolato, come "
"disegnata nella pianta"

#: acoustic_spaces/gui/inspector.py
msgid ""
"What fills it: foliage, which takes so many dB per metre from sound passing "
"through, or leaves by their area and width, which work that out for "
"themselves; and stems, which scatter it sideways"
msgstr ""
"Cosa lo riempie: fogliame, che toglie tanti dB al metro al suono che lo "
"attraversa, o foglie per area e larghezza, che lo ricavano da sé; e fusti, "
"che lo diffondono lateralmente"

#: acoustic_spaces/gui/inspector.py
msgid "Remove the selected vegetation, or the last one when none is selected"
msgstr ""
"Rimuovere la vegetazione selezionata o l'ultima se nessuna è selezionata"

#: acoustic_spaces/gui/inspector.py
msgid "Add vegetation"
msgstr "Aggiungi vegetazione"

#: acoustic_spaces/gui/inspector.py
msgid ""
"Draw the shape chosen beside in the plan: a belt's footprint closed on its "
"first corner, a hedge's path finished with Enter, or a tree's place with one "
"click; dense foliage, its height to change in the table and the rest in the "
"scene file"
msgstr ""
"Disegnare nella pianta la forma scelta accanto: l'impronta di una fascia "
"chiusa sul primo vertice, il tracciato di una siepe terminato con Invio, o "
"il posto di un albero con un clic; fogliame denso, l'altezza da modificare "
"nella tabella e il resto nel file di scena"

#: acoustic_spaces/gui/inspector.py
msgid "Remove vegetation"
msgstr "Rimuovi vegetazione"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"What to draw next: a belt of trees (its footprint, corner by corner), a "
"hedge (its path, point by point, {width:g} m wide) or a lone tree (one "
"click, its crown {crown:g} m across)"
msgstr ""
"Cosa disegnare: una fascia di alberi (la sua impronta, vertice per vertice), "
"una siepe (il suo tracciato, punto per punto, larga {width:g} m) o un albero "
"isolato (un clic, con la chioma di {crown:g} m di diametro)"

#: acoustic_spaces/gui/inspector.py
msgid ""
"The map the buildings marked 'from the buildings file' come from: a GeoJSON "
"file of footprints, each raised to the height a property of it gives (or one "
"height for all) and named by another"
msgstr ""
"La mappa da cui vengono gli edifici segnati come «dal file degli edifici»: "
"un file GeoJSON di impronte, ciascuna sollevata fino all'altezza data da una "
"sua proprietà (o una stessa altezza per tutte) e con il nome di un'altra"

#: acoustic_spaces/gui/inspector.py
msgid "Buildings from a map…"
msgstr "Edifici da una mappa…"

#: acoustic_spaces/gui/inspector.py
