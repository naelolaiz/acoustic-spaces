msgstr ""
"Rimuovere la zona del terreno selezionata o l'ultima se nessuna è "
"selezionata: la sua parte del terreno prende il materiale del terreno"

#: acoustic_spaces/gui/inspector.py
msgid "Add zone"
msgstr "Aggiungi zona"

