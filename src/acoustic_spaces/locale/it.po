msgstr "indice di trasmissione del parlato"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Re free field (dB)"
msgstr "Re campo libero (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"level relative to free field, outdoors: the excess attenuation with its sign "
"turned"
msgstr ""
"livello rispetto al campo libero, all'aperto: l'attenuazione in eccesso con "
"il segno cambiato"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Insertion loss (dB)"
msgstr "Perdita per inserzione (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"insertion loss of the buildings, barriers or vegetation the map was also run "
"without"
msgstr ""
"perdita per inserzione degli edifici, delle barriere acustiche o della "
"vegetazione senza i quali la mappa è stata anche calcolata"

#: acoustic_spaces/engine/coverage.py
msgid "Insertion loss (dB(A))"
msgstr "Perdita per inserzione (dB(A))"

#: acoustic_spaces/engine/coverage.py
msgid "A-weighted insertion loss of the buildings, barriers or vegetation"
msgstr ""
"perdita per inserzione ponderata A degli edifici, delle barriere acustiche o "
"della vegetazione"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Long-term level (dB)"
msgstr "Livello a lungo termine (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"level over a long term, outdoors: the mean over the weather classes and the "
"day"
msgstr ""
"livello a lungo termine, all'aperto: la media sulle classi meteorologiche e "
"sul giorno"

#: acoustic_spaces/engine/coverage.py
msgid "Rating level (dB(A))"
msgstr "Livello di valutazione (dB(A))"

#: acoustic_spaces/engine/coverage.py
msgid "level over a long term with each period's penalty, A-weighted (L_den)"
msgstr ""
"livello a lungo termine con la penalizzazione di ogni periodo, ponderato A "
"(L_den)"

