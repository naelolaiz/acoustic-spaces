msgid_plural "Measured profile at {count} heights, from the scene file"
msgstr[0] "Profilo misurato a {count} altezza, dal file della scena"
msgstr[1] "Profilo misurato a {count} altezze, dal file della scena"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "{name} {hours:g} h +{penalty:g} dB"
msgstr "{name} {hours:g} h +{penalty:g} dB"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "{name} {hours:g} h"
msgstr "{name} {hours:g} h"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid ""
"Levels over a long term: {count} weather class over {periods} ({rating})"
msgid_plural ""
"Levels over a long term: {count} weather classes over {periods} ({rating})"
msgstr[0] ""
"Livelli a lungo termine: {count} classe meteorologica su {periods} ({rating})"
msgstr[1] ""
"Livelli a lungo termine: {count} classi meteorologiche su {periods} "
