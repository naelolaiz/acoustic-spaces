#. Translators: a background task such as "Simulating hall…", then how long it has run so far.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task} {time:.0f} s"
msgstr "{task} {time:.0f} s"

#. Translators: the task and its time, then what it does now.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task}: {step}"
msgstr "{task}: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Now: {step}"
msgstr "Ora: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Running for {time:.0f} s"
msgstr "In corso da {time:.0f} s"

#
#: acoustic_spaces/gui/activity.py
msgid ""
"Cancel, or Simulation > Cancel (Shift+F5), stops it: a run at its next "
"stage, a demo at once"
msgstr ""
"Annulla, o Simulazione > Annulla (Maiusc+F5), la interrompe: un calcolo alla "
"fase successiva, una dimostrazione subito"

#: acoustic_spaces/gui/app.py
msgid "Acoustic Spaces editor"
msgstr "Editor di Acoustic Spaces"

#: acoustic_spaces/gui/app.py
msgid "Scenes (*.yaml *.yml)"
msgstr "Scene (*.yaml *.yml)"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New building with {count} corners, {height:g} m high; change its height "
"under Geometry."
msgstr ""
"Nuovo edificio con {count} vertici, alto {height:g} m; modificarne l'altezza "
"in Geometria."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New barrier along {count} points, {height:g} m high; change its height under "
"Geometry."
msgstr ""
"Nuova barriera con {count} punti, alta {height:g} m; modificarne l'altezza "
"in Geometria."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New belt of trees with {count} corners, {height:g} m high, with dense "
"foliage; change its height under Geometry and the rest in the scene file."
msgstr ""
"Nuova fascia di alberi con {count} vertici, alta {height:g} m, con fogliame "
"denso; modificarne l'altezza in Geometria e il resto nel file di scena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New hedge along {count} points, {width:g} m wide and {height:g} m high, with "
"dense foliage; change its height under Geometry and the rest in the scene "
"file."
msgstr ""
"Nuova siepe con {count} punti, larga {width:g} m e alta {height:g} m, con "
"fogliame denso; modificarne l'altezza in Geometria e il resto nel file di "
"scena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New tree {height:g} m high, its crown {crown_diameter:g} m across from "
"{base:g} m up, with dense foliage; change its height under Geometry and the "
"rest in the scene file."
msgstr ""
"Nuovo albero alto {height:g} m, con la chioma di {crown_diameter:g} m di "
"diametro da {base:g} m in su e fogliame denso; modificarne l'altezza in "
"Geometria e il resto nel file di scena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New ground zone with {count} corners; give its surface a material of its own "
"in the scene tree."
msgstr ""
"Nuova zona del terreno con {count} vertici; assegnare un materiale proprio "
"alla sua superficie nell'albero della scena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New weather zone with {count} corners; choose it under Weather of in the "
"scene's entry to give it wind and temperature of its own."
msgstr ""
"Nuova zona meteorologica con {count} vertici; sceglierla in Tempo di, nella "
"voce della scena, per darle vento e temperatura propri."

#. Translators: {patterns} is the list of model file patterns, such as *.obj *.dxf.
#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Models ({patterns})"
msgstr "Modelli ({patterns})"

#: acoustic_spaces/gui/app.py
msgid "glTF binary (*.glb)"
msgstr "glTF binario (*.glb)"

#: acoustic_spaces/gui/app.py
msgid "Pack (*.zip)"
msgstr "Pacchetto (*.zip)"

#. Translators: two file types of a save dialog, kept apart by ;; (keep it).
#: acoustic_spaces/gui/app.py
msgid "PNG picture (*.png);;JSON, every map (*.json)"
msgstr "Immagine PNG (*.png);;JSON, tutte le mappe (*.json)"

#: acoustic_spaces/gui/app.py
msgid "3D view"
msgstr "Vista 3D"

#: acoustic_spaces/gui/app.py
msgid "Plan"
msgstr "Pianta"

#: acoustic_spaces/gui/app.py
msgid "The room in 3D: click to select, drag sources and listeners"
msgstr ""
"L'ambiente in 3D: fare clic per selezionare, trascinare sorgenti e ricevitori"

#: acoustic_spaces/gui/app.py
msgid "The room from above: draw floor plans, drag corners and points"
msgstr "L'ambiente dall'alto: disegnare piante, trascinare vertici e punti"

#: acoustic_spaces/gui/app.py
msgid "Properties"
msgstr "Proprietà"

#: acoustic_spaces/gui/app.py
msgid "Results"
msgstr "Risultati"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Coverage map"
msgstr "Mappa di copertura"

#: acoustic_spaces/gui/app.py
msgid "Messages"
msgstr "Messaggi"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/demo_dialog.py
msgid "Movement"
msgstr "Movimento"

#: acoustic_spaces/gui/app.py
msgid "Scene YAML"
msgstr "YAML della scena"

#: acoustic_spaces/gui/app.py
msgid ""
"What plays through the room: the recording, and the source and listener of "
"the response it plays through"
msgstr ""
"L'audio riprodotto attraverso l'ambiente: la registrazione, la sorgente e il "
"ricevitore della risposta utilizzata"

#: acoustic_spaces/gui/app.py
msgid "&New box room…"
msgstr "&Nuovo ambiente rettangolare…"

#: acoustic_spaces/gui/app.py
msgid "Start a new scene in a box-shaped room"
msgstr "Creare una nuova scena in un ambiente rettangolare"

#: acoustic_spaces/gui/app.py
msgid "New from &model file…"
msgstr "Nuovo da file di &modello…"

#: acoustic_spaces/gui/app.py
msgid "Start from a model file (OBJ, DXF, glTF, STL, IFC, Collada or SketchUp)"
msgstr ""
"Iniziare da un file di modello (OBJ, DXF, glTF, STL, IFC, Collada o SketchUp)"

#: acoustic_spaces/gui/app.py
msgid "New room from a &floor plan…"
msgstr "Nuovo ambiente da una &pianta…"

#: acoustic_spaces/gui/app.py
msgid "Draw the floor plan of a new room, corner by corner"
msgstr "Disegnare la pianta di un nuovo ambiente, vertice per vertice"

#: acoustic_spaces/gui/app.py
msgid "New o&utdoor scene…"
msgstr "Nuova scena all'aper&to…"

#: acoustic_spaces/gui/app.py
msgid ""
"Start a new scene on open ground, to draw buildings, barriers, vegetation "
"and ground zones on, or to set a terrain and buildings from a map"
msgstr ""
"Creare una nuova scena su terreno aperto, per disegnarvi edifici, barriere, "
"vegetazione e zone del terreno, o per impostarvi un rilievo ed edifici da "
"una mappa"

#: acoustic_spaces/gui/app.py
msgid "&Open…"
msgstr "&Apri…"

#: acoustic_spaces/gui/app.py
msgid "Open a scene file (YAML)"
msgstr "Aprire un file di scena (YAML)"

#: acoustic_spaces/gui/app.py
msgid "&Save"
msgstr "&Salva"

#: acoustic_spaces/gui/app.py
msgid "Save the scene; an example asks where to keep your copy"
msgstr ""
"Salvare la scena; per un esempio viene chiesto dove salvare la propria copia"

#: acoustic_spaces/gui/app.py
msgid "Save &as…"
msgstr "Salva &con nome…"

#: acoustic_spaces/gui/app.py
msgid "Save the scene in another file"
msgstr "Salvare la scena in un altro file"

#: acoustic_spaces/gui/app.py
msgid "&Export results…"
msgstr "Esporta &risultati…"

#: acoustic_spaces/gui/app.py
msgid ""
"Write every response of the last run to a folder: a WAV file per output "
"format and parameters.json, as acoustic-spaces simulate does"
msgstr ""
"Salvare tutte le risposte dell'ultimo calcolo in una cartella: un file WAV "
"per formato di uscita e parameters.json, come acoustic-spaces simulate"

#: acoustic_spaces/gui/app.py
msgid "Export to &Blender…"
msgstr "Esporta in &Blender…"

#: acoustic_spaces/gui/app.py
msgid "The room, and the reflection paths on show, as glTF"
msgstr "L'ambiente e i percorsi di riflessione visualizzati, in formato glTF"

#: acoustic_spaces/gui/app.py
msgid "Export &particle animation to Blender…"
msgstr "Esporta animazione di particelle in B&lender…"

#: acoustic_spaces/gui/app.py
msgid ""
"Sound particles from the selected source (or the first) as a glTF animation: "
"as much of the sound, as slowly and as many particles as you choose"
msgstr ""
"Particelle sonore della sorgente selezionata (o della prima) come animazione "
"glTF: tanto suono, tanto lentamente e tante particelle quante se ne scelgono"

#: acoustic_spaces/gui/app.py
msgid "Pac&k for another computer…"
msgstr "Crea un pacc&hetto per un altro computer…"

#: acoustic_spaces/gui/app.py
msgid ""
"Put the scene and every file it names in one zip file, to run on a server or "
"a cloud job as acoustic-spaces pack does; nothing is uploaded"
msgstr ""
"Raccoglie la scena e tutti i file che nomina in un unico file zip, da "
"calcolare su un server o in un job nel cloud, come acoustic-spaces pack; non "
"viene caricato nulla"

#: acoustic_spaces/gui/app.py
msgid "&Quit"
msgstr "&Esci"

#: acoustic_spaces/gui/app.py
msgid "Close the editor; it asks about unsaved changes"
msgstr "Chiudere l'editor; viene chiesto se salvare le modifiche"

#. Translators: {edit} says what the last edit did, such as "move the source".
#: acoustic_spaces/gui/app.py
msgid "&Undo"
msgstr "&Annulla"

#: acoustic_spaces/gui/app.py
msgid "Take back the last change"
msgstr "Annullare l'ultima modifica"

#: acoustic_spaces/gui/app.py
msgid "&Redo"
msgstr "&Ripeti"

#: acoustic_spaces/gui/app.py
msgid "Make the change Undo took back"
msgstr "Ripristinare la modifica annullata"

#: acoustic_spaces/gui/app.py
msgid "Place &source"
msgstr "Posiziona &sorgente"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a source there"
msgstr ""
"Fare clic su un pavimento o una parete nella vista 3D per posizionare una "
"sorgente"

#: acoustic_spaces/gui/app.py
msgid "Place &listener"
msgstr "Posiziona ri&cevitore"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a listener there"
msgstr ""
"Fare clic su un pavimento o una parete nella vista 3D per posizionare un "
"ricevitore"

#: acoustic_spaces/gui/app.py
msgid "&Draw floor plan"
msgstr "&Disegna pianta"

#: acoustic_spaces/gui/app.py
msgid "Draw a new floor plan in the plan view; it replaces the room"
msgstr ""
"Disegnare una nuova pianta nella vista in pianta; sostituisce l'ambiente"

#: acoustic_spaces/gui/app.py
msgid "Add &material from the database…"
msgstr "Aggiungi &materiale dalla banca dati…"

#: acoustic_spaces/gui/app.py
msgid "A material of the built-in database of absorption coefficients"
msgstr ""
"Un materiale della banca dati integrata di coefficienti di assorbimento"

#: acoustic_spaces/gui/app.py
msgid "Add material from a &library…"
msgstr "Aggiungi materiale da una &libreria…"

#: acoustic_spaces/gui/app.py
msgid ""
"A material of a CATT-Acoustic (ABS lines) or ODEON (.Li8) material library"
msgstr "Un materiale di una libreria CATT-Acoustic (righe ABS) o ODEON (.Li8)"

#: acoustic_spaces/gui/app.py
msgid "Re&move selected"
msgstr "Rimuovi sele&zione"

#: acoustic_spaces/gui/app.py
msgid ""
"Remove the selected source, listener or material (Delete, in the scene tree "
"or a view)"
msgstr ""
"Rimuovere la sorgente, il ricevitore o il materiale selezionato (Canc, "
"nell'albero della scena o in una vista)"

#: acoustic_spaces/gui/app.py
msgid "&Reset camera"
msgstr "&Ripristina vista"

#: acoustic_spaces/gui/app.py
msgid "Show the whole room in the 3D view from the usual angle"
msgstr "Mostrare l'intero ambiente nella vista 3D dall'angolazione abituale"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "Vista &3D"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "Mostrare l'ambiente in 3D"

#: acoustic_spaces/gui/app.py
msgid "P&lan"
msgstr "&Pianta"

#: acoustic_spaces/gui/app.py
msgid "Show the room from above, to draw and change floor plans"
msgstr "Mostrare l'ambiente dall'alto, per disegnare e modificare piante"

#: acoustic_spaces/gui/app.py
msgid "Edit &movement…"
msgstr "Modifica mo&vimento…"

#: acoustic_spaces/gui/app.py
msgid ""
"Open the Movement panel: where the selected source or listener is and how it "
"faces at each time of a movement, with a timeline every mover is previewed "
"along"
msgstr ""
"Apre il pannello Movimento: dove si trova e dove guarda la sorgente o il "
"ricevitore selezionato in ogni istante di un movimento, con una linea "
"temporale lungo la quale si vedono in anteprima tutti i mobili"

#: acoustic_spaces/gui/app.py
msgid "Show reflection &paths"
msgstr "Mostra percorsi di ri&flessione"

#: acoustic_spaces/gui/app.py
msgid ""
"Draw the early reflection paths of the source and listener the Results panel "
"shows, coloured by order"
msgstr ""
"Disegnare i percorsi delle prime riflessioni della sorgente e del ricevitore "
"mostrati nel pannello Risultati, colorati per ordine"

#: acoustic_spaces/gui/app.py
msgid "Show &leaks"
msgstr "Mostra f&ughe"

#: acoustic_spaces/gui/app.py
msgid ""
"Trace rays from the sources and show where they escape from a model that is "
"not closed"
msgstr ""
"Tracciare raggi dalle sorgenti e mostrare dove escono da un modello non "
"chiuso"

#: acoustic_spaces/gui/app.py
msgid "Show &wind"
msgstr "Mostra &vento"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, draw the wind in the 3D view and the plan: arrows the way it "
"blows, as long as it is strong, at the height the scene gives its speed at, "
"and each weather zone with its wind"
msgstr ""
"All'aperto, disegnare il vento nella vista 3D e nella pianta: frecce nella "
"direzione in cui soffia, lunghe quanto è forte, all'altezza a cui la scena "
"ne dà la velocità, e ogni zona meteorologica con il suo vento"

#: acoustic_spaces/gui/app.py
msgid "Show wind pro&file"
msgstr "Mostra pr&ofilo del vento"

