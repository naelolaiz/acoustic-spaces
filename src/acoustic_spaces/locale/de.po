msgstr[0] ""
"Einfügungsdämpfung von {names}: die Szene wurde auch ohne diesen Teil "
"berechnet"
msgstr[1] ""
"Einfügungsdämpfung von {names}: die Szene wurde auch ohne diese Teile "
"berechnet"

#: acoustic_spaces/gui/results_view.py
#, python-brace-format
msgid ""
"Levels over a long term in {count} weather class ({names}), rated as {rating}"
msgid_plural ""
