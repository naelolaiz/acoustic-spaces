msgid "Scene"
msgstr "Szene"

#: acoustic_spaces/gui/app.py
msgid "Properties"
msgstr "Eigenschaften"

#: acoustic_spaces/gui/app.py
msgid "Results"
msgstr "Ergebnisse"

