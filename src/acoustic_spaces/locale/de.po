msgstr "Läuft seit {time:.0f} s"

#: acoustic_spaces/gui/activity.py
msgid "Cancel, or Simulation > Cancel (Shift+F5), stops it at its next stage"
msgstr ""
"Abbrechen oder Simulation > Abbrechen (Umschalt+F5) beendet sie beim "
"nächsten Schritt"

#: acoustic_spaces/gui/app.py
msgid "Acoustic Spaces editor"
msgstr "Acoustic Spaces Editor"

#: acoustic_spaces/gui/app.py
msgid "Scenes (*.yaml *.yml)"
msgstr "Szenen (*.yaml *.yml)"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New building with {count} corners, {height:g} m high; change its height "
"under Geometry."
msgstr ""
"Neues Gebäude mit {count} Ecken, {height:g} m hoch; die Höhe unter Geometrie "
"ändern."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New barrier along {count} points, {height:g} m high; change its height under "
"Geometry."
msgstr ""
"Neuer Schallschirm mit {count} Punkten, {height:g} m hoch; die Höhe unter "
"Geometrie ändern."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New belt of trees with {count} corners, {height:g} m high, with dense "
"foliage; change its height under Geometry and the rest in the scene file."
msgstr ""
"Neuer Baumgürtel mit {count} Ecken, {height:g} m hoch, mit dichtem Laub; die "
"Höhe unter Geometrie und das Übrige in der Szenendatei ändern."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New hedge along {count} points, {width:g} m wide and {height:g} m high, with "
"dense foliage; change its height under Geometry and the rest in the scene "
"file."
msgstr ""
"Neue Hecke mit {count} Punkten, {width:g} m breit und {height:g} m hoch, mit "
"dichtem Laub; die Höhe unter Geometrie und das Übrige in der Szenendatei "
"ändern."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New tree {height:g} m high, its crown {crown_diameter:g} m across from "
"{base:g} m up, with dense foliage; change its height under Geometry and the "
"rest in the scene file."
msgstr ""
"Neuer Baum, {height:g} m hoch, Krone mit {crown_diameter:g} m Durchmesser ab "
"{base:g} m Höhe, mit dichtem Laub; die Höhe unter Geometrie und das Übrige "
"in der Szenendatei ändern."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New ground zone with {count} corners; give its surface a material of its own "
"in the scene tree."
msgstr ""
"Neue Bodenzone mit {count} Ecken; ihrer Fläche im Szenenbaum ein eigenes "
"Material zuweisen."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New weather zone with {count} corners; choose it under Weather of in the "
"scene's entry to give it wind and temperature of its own."
msgstr ""
"Neue Wetterzone mit {count} Ecken; unter „Wetterlage von“ im Eintrag der "
"Szene auswählen, um ihr eigenen Wind und eigene Temperatur zu geben."

#. Translators: {patterns} is the list of model file patterns, such as *.obj *.dxf.
