#: acoustic_spaces/cli.py
#, python-brace-format
msgid "chosen in the editor, kept in {path}"
msgstr "triat a l'editor, desat a {path}"

#: acoustic_spaces/cli.py
msgid "this computer's"
msgstr "el d'aquest ordinador"

#: acoustic_spaces/cli.py
#, python-brace-format
msgid "language: {language} ({source})"
msgstr "idioma: {language} ({source})"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "SPL (dB)"
msgstr "SPL (dB)"

#: acoustic_spaces/engine/coverage.py
msgid "sound pressure level"
msgstr "nivell de pressió sonora"

#: acoustic_spaces/engine/coverage.py
msgid "SPL (dB(A))"
msgstr "SPL (dB(A))"

#: acoustic_spaces/engine/coverage.py
msgid "A-weighted sound pressure level"
msgstr "nivell de pressió sonora amb ponderació A"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "G (dB)"
msgstr "G (dB)"

#: acoustic_spaces/engine/coverage.py
msgid "strength"
msgstr "força sonora"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "C50 (dB)"
msgstr "C50 (dB)"

#: acoustic_spaces/engine/coverage.py
msgid "clarity, 50 ms"
msgstr "claredat, 50 ms"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "C80 (dB)"
msgstr "C80 (dB)"

#: acoustic_spaces/engine/coverage.py
msgid "clarity, 80 ms"
msgstr "claredat, 80 ms"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "D50"
msgstr "D50"

#: acoustic_spaces/engine/coverage.py
msgid "definition"
msgstr "definició"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "EDT (s)"
msgstr "EDT (s)"

#: acoustic_spaces/engine/coverage.py
msgid "early decay time"
msgstr "temps de decaïment inicial"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "T20 (s)"
msgstr "T20 (s)"

#: acoustic_spaces/engine/coverage.py
msgid "reverberation time from a 20 dB decay"
msgstr "temps de reverberació a partir d'un decaïment de 20 dB"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "T30 (s)"
msgstr "T30 (s)"

#: acoustic_spaces/engine/coverage.py
msgid "reverberation time from a 30 dB decay"
msgstr "temps de reverberació a partir d'un decaïment de 30 dB"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Ts (ms)"
msgstr "Ts (ms)"

#: acoustic_spaces/engine/coverage.py
msgid "centre time"
msgstr "temps central"

#: acoustic_spaces/engine/coverage.py
msgid "STI"
msgstr "STI"

#: acoustic_spaces/engine/coverage.py
msgid "speech transmission index"
msgstr "índex de transmissió de la parla"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Re free field (dB)"
msgstr "Re camp lliure (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"level relative to free field, outdoors: the excess attenuation with its sign "
"turned"
msgstr ""
"nivell respecte del camp lliure, a l'aire lliure: l'atenuació en excés amb "
"el signe canviat"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Insertion loss (dB)"
msgstr "Pèrdua per inserció (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"insertion loss of the buildings, barriers or vegetation the map was also run "
"without"
msgstr ""
"pèrdua per inserció dels edificis, pantalles acústiques o vegetació sense "
"els quals també s'ha calculat el mapa"

#: acoustic_spaces/engine/coverage.py
msgid "Insertion loss (dB(A))"
msgstr "Pèrdua per inserció (dB(A))"

#: acoustic_spaces/engine/coverage.py
msgid "A-weighted insertion loss of the buildings, barriers or vegetation"
msgstr ""
"pèrdua per inserció ponderada A dels edificis, pantalles acústiques o "
"vegetació"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Long-term level (dB)"
msgstr "Nivell a llarg termini (dB)"

#: acoustic_spaces/engine/coverage.py
msgid ""
"level over a long term, outdoors: the mean over the weather classes and the "
"day"
msgstr ""
"nivell a llarg termini, a l'aire lliure: la mitjana sobre les classes "
"meteorològiques i el dia"

#: acoustic_spaces/engine/coverage.py
msgid "Rating level (dB(A))"
msgstr "Nivell d'avaluació (dB(A))"

#: acoustic_spaces/engine/coverage.py
msgid "level over a long term with each period's penalty, A-weighted (L_den)"
msgstr ""
"nivell a llarg termini amb la penalització de cada període, ponderat A "
"(L_den)"

#: acoustic_spaces/examples.py
msgid "Rooms"
msgstr "Recintes"

#: acoustic_spaces/examples.py
msgid "Halls and churches"
msgstr "Sales i esglésies"

#: acoustic_spaces/examples.py
msgid "Sound systems"
msgstr "Sistemes de so"

#: acoustic_spaces/examples.py acoustic_spaces/gui/inspector.py
msgid "Outdoors"
msgstr "A l'aire lliure"

#: acoustic_spaces/examples.py
msgid "Models from CAD and BIM files"
msgstr "Models de fitxers CAD i BIM"

#: acoustic_spaces/examples.py
msgid "Measurements and material libraries"
msgstr "Mesures i biblioteques de materials"

#: acoustic_spaces/examples.py
msgid "Other examples"
msgstr "Altres exemples"

#. Translators: a background task such as "Simulating hall…", then how long it has run so far.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task} {time:.0f} s"
msgstr "{task} {time:.0f} s"

#. Translators: the task and its time, then what it does now.
#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "{task}: {step}"
msgstr "{task}: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Now: {step}"
msgstr "Ara: {step}"

#: acoustic_spaces/gui/activity.py
#, python-brace-format
msgid "Running for {time:.0f} s"
msgstr "En marxa des de fa {time:.0f} s"

#: acoustic_spaces/gui/activity.py
msgid "Cancel, or Simulation > Cancel (Shift+F5), stops it at its next stage"
msgstr ""
"Cancel·lar, o Simulació > Cancel·lar (Maj+F5), l'atura a la següent etapa"

#: acoustic_spaces/gui/app.py
msgid "Acoustic Spaces editor"
msgstr "Editor d'Acoustic Spaces"

#: acoustic_spaces/gui/app.py
msgid "Scenes (*.yaml *.yml)"
msgstr "Escenes (*.yaml *.yml)"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New building with {count} corners, {height:g} m high; change its height "
"under Geometry."
msgstr ""
"Edifici nou amb {count} vèrtexs, de {height:g} m d'alçada; l'alçada es "
"canvia a Geometria."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New barrier along {count} points, {height:g} m high; change its height under "
"Geometry."
msgstr ""
"Pantalla nova amb {count} punts, de {height:g} m d'alçada; l'alçada es "
"canvia a Geometria."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New belt of trees with {count} corners, {height:g} m high, with dense "
"foliage; change its height under Geometry and the rest in the scene file."
msgstr ""
"Franja d'arbres nova amb {count} vèrtexs, de {height:g} m d'alçada, amb "
"fullatge dens; l'alçada es canvia a Geometria i la resta al fitxer d'escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New hedge along {count} points, {width:g} m wide and {height:g} m high, with "
"dense foliage; change its height under Geometry and the rest in the scene "
"file."
msgstr ""
"Tanca nova amb {count} punts, de {width:g} m d'amplada i {height:g} m "
"d'alçada, amb fullatge dens; l'alçada es canvia a Geometria i la resta al "
"fitxer d'escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New tree {height:g} m high, its crown {crown_diameter:g} m across from "
"{base:g} m up, with dense foliage; change its height under Geometry and the "
"rest in the scene file."
msgstr ""
"Arbre nou de {height:g} m d'alçada, amb la capçada de {crown_diameter:g} m "
"de diàmetre des de {base:g} m d'alt i fullatge dens; l'alçada es canvia a "
"Geometria i la resta al fitxer d'escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New ground zone with {count} corners; give its surface a material of its own "
"in the scene tree."
msgstr ""
"Zona del terreny nova amb {count} vèrtexs; assigneu un material propi a la "
"seva superfície a l'arbre de l'escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New weather zone with {count} corners; choose it under Weather of in the "
"scene's entry to give it wind and temperature of its own."
msgstr ""
"Zona meteorològica nova amb {count} vèrtexs; trieu-la a Temps de, a "
"l'entrada de l'escena, per donar-li vent i temperatura propis."

#. Translators: {patterns} is the list of model file patterns, such as *.obj *.dxf.
#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Models ({patterns})"
msgstr "Models ({patterns})"

#: acoustic_spaces/gui/app.py
msgid "glTF binary (*.glb)"
msgstr "glTF binari (*.glb)"

#. Translators: two file types of a save dialog, kept apart by ;; (keep it).
#: acoustic_spaces/gui/app.py
msgid "PNG picture (*.png);;JSON, every map (*.json)"
msgstr "Imatge PNG (*.png);;JSON, tots els mapes (*.json)"

#: acoustic_spaces/gui/app.py
msgid "3D view"
msgstr "Vista 3D"

#: acoustic_spaces/gui/app.py
msgid "Plan"
msgstr "Planta"

#: acoustic_spaces/gui/app.py
msgid "The room in 3D: click to select, drag sources and listeners"
msgstr "El recinte en 3D: clic per seleccionar; arrossegar fonts i receptors"

#: acoustic_spaces/gui/app.py
msgid "The room from above: draw floor plans, drag corners and points"
msgstr ""
"El recinte vist des de dalt: dibuixar plantes; arrossegar vèrtexs i punts"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Scene"
msgstr "Escena"

#: acoustic_spaces/gui/app.py
msgid "Properties"
msgstr "Propietats"

#: acoustic_spaces/gui/app.py
msgid "Results"
msgstr "Resultats"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Coverage map"
msgstr "Mapa de cobertura"

#: acoustic_spaces/gui/app.py
msgid "Messages"
msgstr "Missatges"

#: acoustic_spaces/gui/app.py
msgid ""
"What plays through the room: the recording, and the source and listener of "
"the response it plays through"
msgstr ""
"El que es reprodueix a través del recinte: l'enregistrament, i la font i el "
"receptor de la resposta per la qual passa"

#: acoustic_spaces/gui/app.py
msgid "&New box room…"
msgstr "&Nou recinte rectangular…"

#: acoustic_spaces/gui/app.py
msgid "Start a new scene in a box-shaped room"
msgstr "Començar una escena nova en un recinte rectangular"

#: acoustic_spaces/gui/app.py
msgid "New from &model file…"
msgstr "Nou des d'un fitxer de &model…"

#: acoustic_spaces/gui/app.py
msgid "Start from a model file (OBJ, DXF, glTF, STL, IFC, Collada or SketchUp)"
msgstr ""
"Començar des d'un fitxer de model (OBJ, DXF, glTF, STL, IFC, Collada o "
"SketchUp)"

#: acoustic_spaces/gui/app.py
msgid "New room from a &floor plan…"
msgstr "Nou recinte des d'una &planta…"

#: acoustic_spaces/gui/app.py
msgid "Draw the floor plan of a new room, corner by corner"
msgstr "Dibuixar la planta d'un recinte nou, vèrtex a vèrtex"

#: acoustic_spaces/gui/app.py
msgid "New o&utdoor scene…"
msgstr "Nova escena a l'aire &lliure…"

#: acoustic_spaces/gui/app.py
msgid ""
"Start a new scene on open ground, to draw buildings, barriers, vegetation "
"and ground zones on, or to set a terrain and buildings from a map"
msgstr ""
"Començar una escena nova sobre terreny obert, per dibuixar-hi edificis, "
"pantalles acústiques, vegetació i zones del terreny, o per posar-hi un "
"relleu i edificis des d'un mapa"

#: acoustic_spaces/gui/app.py
msgid "&Open…"
msgstr "&Obrir…"

#: acoustic_spaces/gui/app.py
msgid "Open a scene file (YAML)"
msgstr "Obrir un fitxer d'escena (YAML)"

#: acoustic_spaces/gui/app.py
msgid "&Save"
msgstr "&Desar"

#: acoustic_spaces/gui/app.py
msgid "Save the scene; an example asks where to keep your copy"
msgstr "Desar l'escena; amb un exemple es demana on desar la còpia"

#: acoustic_spaces/gui/app.py
msgid "Save &as…"
msgstr "Desar &com a…"

#: acoustic_spaces/gui/app.py
msgid "Save the scene in another file"
msgstr "Desar l'escena en un altre fitxer"

#: acoustic_spaces/gui/app.py
msgid "&Export results…"
msgstr "Exportar &resultats…"

#: acoustic_spaces/gui/app.py
msgid ""
"Write every response of the last run to a folder: a WAV file per output "
"format and parameters.json, as acoustic-spaces simulate does"
msgstr ""
"Escriure totes les respostes de l'últim càlcul en una carpeta: un fitxer WAV "
"per format de sortida i parameters.json, com fa acoustic-spaces simulate"

#: acoustic_spaces/gui/app.py
msgid "Export to &Blender…"
msgstr "Exportar a &Blender…"

#: acoustic_spaces/gui/app.py
msgid "The room, and the reflection paths on show, as glTF"
msgstr "El recinte i les trajectòries de reflexió visibles, en glTF"

#: acoustic_spaces/gui/app.py
msgid "Export &particle animation to Blender…"
msgstr "Exportar l'animació de partícules a Bl&ender…"

#: acoustic_spaces/gui/app.py
msgid ""
"Sound particles from the selected source (or the first) as a glTF animation: "
"as much of the sound, as slowly and as many particles as you choose"
msgstr ""
"Partícules sonores de la font seleccionada (o de la primera) com a animació "
"glTF: tant so, tan a poc a poc i tantes partícules com trieu"

#: acoustic_spaces/gui/app.py
msgid "&Quit"
msgstr "&Sortir"

#: acoustic_spaces/gui/app.py
msgid "Close the editor; it asks about unsaved changes"
msgstr "Tancar l'editor; demana què fer amb els canvis sense desar"

#. Translators: {edit} says what the last edit did, such as "move the source".
#: acoustic_spaces/gui/app.py
msgid "&Undo"
msgstr "&Desfer"

#: acoustic_spaces/gui/app.py
msgid "Take back the last change"
msgstr "Desfer l'últim canvi"

#: acoustic_spaces/gui/app.py
msgid "&Redo"
msgstr "&Refer"

#: acoustic_spaces/gui/app.py
msgid "Make the change Undo took back"
msgstr "Tornar a aplicar el canvi que s'ha desfet"

#: acoustic_spaces/gui/app.py
msgid "Place &source"
msgstr "Col·locar &font"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a source there"
msgstr ""
"Fer clic en un terra o una paret de la vista 3D per col·locar-hi una font"

#: acoustic_spaces/gui/app.py
msgid "Place &listener"
msgstr "Col·locar r&eceptor"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a listener there"
msgstr ""
"Fer clic en un terra o una paret de la vista 3D per col·locar-hi un receptor"

#: acoustic_spaces/gui/app.py
msgid "&Draw floor plan"
msgstr "D&ibuixar planta"

#: acoustic_spaces/gui/app.py
msgid "Draw a new floor plan in the plan view; it replaces the room"
msgstr "Dibuixar una planta nova a la vista de planta; substitueix el recinte"

#: acoustic_spaces/gui/app.py
msgid "Add &material from the database…"
msgstr "Afegir &material de la base de dades…"

#: acoustic_spaces/gui/app.py
msgid "A material of the built-in database of absorption coefficients"
msgstr "Un material de la base de dades integrada de coeficients d'absorció"

#: acoustic_spaces/gui/app.py
msgid "Add material from a &library…"
msgstr "Afegir material d'una &biblioteca…"

#: acoustic_spaces/gui/app.py
msgid ""
"A material of a CATT-Acoustic (ABS lines) or ODEON (.Li8) material library"
msgstr ""
"Un material d'una biblioteca de materials de CATT-Acoustic (línies ABS) o "
"ODEON (.Li8)"

#: acoustic_spaces/gui/app.py
msgid "Re&move selected"
msgstr "E&liminar la selecció"

#: acoustic_spaces/gui/app.py
msgid ""
"Remove the selected source, listener or material (Delete, in the scene tree "
"or a view)"
msgstr ""
"Eliminar la font, el receptor o el material seleccionat (Supr, a l'arbre de "
"l'escena o en una vista)"

#: acoustic_spaces/gui/app.py
msgid "&Reset camera"
msgstr "&Restablir la càmera"

#: acoustic_spaces/gui/app.py
msgid "Show the whole room in the 3D view from the usual angle"
msgstr "Mostrar tot el recinte a la vista 3D des de l'angle habitual"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "Vista &3D"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "Mostrar el recinte en 3D"

#: acoustic_spaces/gui/app.py
msgid "P&lan"
msgstr "&Planta"

#: acoustic_spaces/gui/app.py
msgid "Show the room from above, to draw and change floor plans"
msgstr "Mostrar el recinte des de dalt, per dibuixar i modificar plantes"

#: acoustic_spaces/gui/app.py
msgid "Show reflection &paths"
msgstr "Mostrar &trajectòries de reflexió"

#: acoustic_spaces/gui/app.py
msgid ""
"Draw the early reflection paths of the source and listener the Results panel "
"shows, coloured by order"
msgstr ""
"Dibuixar les trajectòries de les primeres reflexions de la font i el "
"receptor del tauler Resultats, amb colors segons l'ordre"

#: acoustic_spaces/gui/app.py
msgid "Show &leaks"
msgstr "Mostrar &fuites"

#: acoustic_spaces/gui/app.py
msgid ""
"Trace rays from the sources and show where they escape from a model that is "
"not closed"
msgstr ""
"Traçar raigs des de les fonts i mostrar per on s'escapen d'un model que no "
"és tancat"

#: acoustic_spaces/gui/app.py
msgid "Show &wind"
msgstr "Mostrar el &vent"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, draw the wind in the 3D view and the plan: arrows the way it "
"blows, as long as it is strong, at the height the scene gives its speed at, "
"and each weather zone with its wind"
msgstr ""
"A l'aire lliure, dibuixar el vent a la vista 3D i a la planta: fletxes en la "
"direcció en què bufa, tan llargues com fort és, a l'alçada a la qual "
"l'escena en dona la velocitat, i cada zona meteorològica amb el seu vent"

#: acoustic_spaces/gui/app.py
msgid "Show wind pro&file"
msgstr "Mostrar el p&erfil del vent"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, stand a mast in the 3D view in each weather where the wind blows, "
"with arrows up it and a curve: how the wind grows with height over the ground"
msgstr ""
"A l'aire lliure, aixecar a la vista 3D un pal a l'escena i a cada zona "
"meteorològica on bufa el vent, amb fletxes al llarg i una corba: com creix "
"el vent amb l'alçada sobre el terreny"

#: acoustic_spaces/gui/app.py
msgid "Save &screenshot…"
msgstr "Desar &captura de pantalla…"

#: acoustic_spaces/gui/app.py
msgid "Save the 3D view as a PNG picture"
msgstr "Desar la vista 3D com a imatge PNG"

#: acoustic_spaces/gui/app.py
msgid "&Run"
msgstr "&Calcular"

#: acoustic_spaces/gui/app.py
msgid "Simulate every source and listener"
msgstr "Simular totes les fonts i tots els receptors"

#: acoustic_spaces/gui/app.py
msgid "Run coverage &map"
msgstr "Calcular &mapa de cobertura"

#: acoustic_spaces/gui/app.py
msgid "Room parameters on a grid over the audience area, for every source"
msgstr ""
"Paràmetres acústics en una quadrícula sobre la zona de públic, per a cada "
"font"

#: acoustic_spaces/gui/app.py
msgid "Map"
msgstr "Mapa"

#: acoustic_spaces/gui/app.py
msgid "&Tune CPU and GPU…"
msgstr "&Ajustar CPU i GPU…"

#: acoustic_spaces/gui/app.py
msgid ""
"Time the CPU and the GPU on this scene and keep the fastest on this computer "
"for the device setting auto (acoustic-spaces tune; needs the gpu extra)"
msgstr ""
"Mesurar el temps de la CPU i la GPU en aquesta escena i conservar la més "
"ràpida en aquest ordinador per al dispositiu automàtic (acoustic-spaces "
"tune; requereix l'extra gpu)"

#: acoustic_spaces/gui/app.py
msgid "&Cancel"
msgstr "Ca&ncel·lar"

#: acoustic_spaces/gui/app.py
msgid "Stop the run, coverage map or tuning going on, at its next stage"
msgstr ""
"Aturar el càlcul, el mapa de cobertura o l'ajust en curs a la fase següent"

#: acoustic_spaces/gui/app.py
msgid "S&top playback"
msgstr "A&turar la reproducció"

#: acoustic_spaces/gui/app.py
msgid "Stop the recording playing through the room (Esc)"
msgstr "Aturar l'enregistrament que es reprodueix a través del recinte (Esc)"

#: acoustic_spaces/gui/app.py
msgid "Stop playback (Esc)"
msgstr "Aturar la reproducció (Esc)"

#: acoustic_spaces/gui/app.py
msgid "&About"
msgstr "&Quant a"

#: acoustic_spaces/gui/app.py
msgid "The version, licence and source of Acoustic Spaces"
msgstr "La versió, la llicència i el codi font d'Acoustic Spaces"

#: acoustic_spaces/gui/app.py
msgid "Undo"
msgstr "Desfer"

#: acoustic_spaces/gui/app.py
msgid "Redo"
msgstr "Refer"

#: acoustic_spaces/gui/app.py
msgid "&File"
msgstr "&Fitxer"

#: acoustic_spaces/gui/app.py
msgid "Open e&xample"
msgstr "Obrir e&xemple"

#: acoustic_spaces/gui/app.py
msgid "&Edit"
msgstr "&Editar"

#: acoustic_spaces/gui/app.py
msgid "&View"
msgstr "&Veure"

#. Translators: {panel} is a panel's title, such as Results.
#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Show or hide the {panel} panel"
msgstr "Mostrar o amagar el tauler {panel}"

#: acoustic_spaces/gui/app.py
msgid "&Language"
msgstr "&Idioma"

#: acoustic_spaces/gui/app.py
msgid "&Simulation"
msgstr "&Simulació"

#: acoustic_spaces/gui/app.py
msgid "&Help"
msgstr "&Ajuda"

#: acoustic_spaces/gui/app.py
msgid "Main"
msgstr "Principal"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "System ({language})"
msgstr "Sistema ({language})"

#: acoustic_spaces/gui/app.py
msgid ""
"Show the editor and the command line in this computer's language, from their "
"next start"
msgstr ""
"Mostrar l'editor i la línia d'ordres en l'idioma d'aquest ordinador a partir "
"del proper inici"

#: acoustic_spaces/gui/app.py
msgid ""
"Show the editor and the command line in this language, from their next start"
msgstr ""
"Mostrar l'editor i la línia d'ordres en aquest idioma a partir del proper "
"inici"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Cannot keep the language: {reason}"
msgstr "No es pot desar l'idioma: {reason}"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"{variable} is set to {value}, so it decides the language, not this choice"
msgstr ""
"{variable} té el valor {value}, per tant decideix l'idioma en lloc d'aquesta "
"tria"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"Language from the next start of the editor and the command line: {language}"
msgstr ""
