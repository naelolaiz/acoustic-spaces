msgid "Save the scene; an example asks where to keep your copy"
msgstr "Guardar la escena; con un ejemplo se pregunta dónde guardar la copia"

#: acoustic_spaces/gui/app.py
msgid "Save &as…"
msgstr "Guardar &como…"

#: acoustic_spaces/gui/app.py
msgid "Save the scene in another file"
msgstr "Guardar la escena en otro archivo"

#: acoustic_spaces/gui/app.py
msgid "&Export results…"
msgstr "E&xportar resultados…"

#: acoustic_spaces/gui/app.py
msgid ""
"Write every response of the last run to a folder: a WAV file per output "
"format and parameters.json, as acoustic-spaces simulate does"
msgstr ""
"Escribir todas las respuestas del último cálculo en una carpeta: un archivo "
"WAV por formato de salida y parameters.json, como hace acoustic-spaces "
"simulate"

#: acoustic_spaces/gui/app.py
msgid "Export to &Blender…"
msgstr "Exportar a &Blender…"

#: acoustic_spaces/gui/app.py
msgid "The room, and the reflection paths on show, as glTF"
msgstr "El recinto y las trayectorias de reflexión visibles, en glTF"

#: acoustic_spaces/gui/app.py
msgid "Export &particle animation to Blender…"
msgstr "Exportar animación de pa&rtículas a Blender…"

#: acoustic_spaces/gui/app.py
msgid ""
"Sound particles from the selected source (or the first) as a glTF animation"
msgstr ""
"Partículas sonoras de la fuente seleccionada (o de la primera) como "
"animación glTF"

#: acoustic_spaces/gui/app.py
msgid "&Quit"
msgstr "&Salir"

#: acoustic_spaces/gui/app.py
msgid "Close the editor; it asks about unsaved changes"
msgstr "Cerrar el editor; antes pregunta por los cambios sin guardar"

#. Translators: {edit} says what the last edit did, such as "move the source".
#: acoustic_spaces/gui/app.py
msgid "&Undo"
msgstr "&Deshacer"

#: acoustic_spaces/gui/app.py
msgid "Take back the last change"
msgstr "Deshacer el último cambio"

#: acoustic_spaces/gui/app.py
msgid "&Redo"
msgstr "&Rehacer"

#: acoustic_spaces/gui/app.py
msgid "Make the change Undo took back"
msgstr "Volver a aplicar el cambio deshecho"

#: acoustic_spaces/gui/app.py
msgid "Place &source"
msgstr "Colocar &fuente"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a source there"
msgstr ""
"Hacer clic en un suelo o una pared de la vista 3D para colocar allí una "
"fuente"

