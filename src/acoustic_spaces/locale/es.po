msgid "Draw a new floor plan in the plan view; it replaces the room"
msgstr "Dibujar una planta nueva en la vista de planta; sustituye al recinto"

#: acoustic_spaces/gui/app.py
msgid "Add &material from the database…"
msgstr "Añadir &material de la base de datos…"

#: acoustic_spaces/gui/app.py
msgid "A material of the built-in database of absorption coefficients"
msgstr "Un material de la base de datos integrada de coeficientes de absorción"

#: acoustic_spaces/gui/app.py
msgid "Add material from a &library…"
msgstr "Añadir material de una &biblioteca…"

#: acoustic_spaces/gui/app.py
msgid ""
"A material of a CATT-Acoustic (ABS lines) or ODEON (.Li8) material library"
msgstr ""
"Un material de una biblioteca de materiales de CATT-Acoustic (líneas ABS) u "
"ODEON (.Li8)"

#: acoustic_spaces/gui/app.py
msgid "Re&move selected"
msgstr "&Eliminar selección"

#: acoustic_spaces/gui/app.py
msgid ""
"Remove the selected source, listener or material (Delete, in the scene tree "
"or a view)"
msgstr ""
"Eliminar la fuente, el receptor o el material seleccionado (Supr, en el "
"árbol de la escena o en una vista)"

#: acoustic_spaces/gui/app.py
msgid "&Reset camera"
msgstr "&Restablecer cámara"

#: acoustic_spaces/gui/app.py
msgid "Show the whole room in the 3D view from the usual angle"
msgstr "Mostrar el recinto completo en la vista 3D desde el ángulo habitual"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "Vista &3D"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "Mostrar el recinto en 3D"

#: acoustic_spaces/gui/app.py
msgid "P&lan"
msgstr "P&lanta"

#: acoustic_spaces/gui/app.py
msgid "Show the room from above, to draw and change floor plans"
msgstr ""
"Mostrar el recinto visto desde arriba, para dibujar y modificar plantas"

#: acoustic_spaces/gui/app.py
msgid "Show reflection &paths"
msgstr "Mostrar &trayectorias de reflexión"

