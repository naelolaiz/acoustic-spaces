msgid "&About"
msgstr "&Acerca de"

#: acoustic_spaces/gui/app.py
msgid "The version, licence and source of Acoustic Spaces"
msgstr "La versión, la licencia y el código fuente de Acoustic Spaces"

#: acoustic_spaces/gui/app.py
msgid "Undo"
msgstr "Deshacer"

#: acoustic_spaces/gui/app.py
msgid "Redo"
msgstr "Rehacer"

#: acoustic_spaces/gui/app.py
msgid "&File"
msgstr "&Archivo"

#: acoustic_spaces/gui/app.py
msgid "Open e&xample"
msgstr "Abrir &ejemplo"

