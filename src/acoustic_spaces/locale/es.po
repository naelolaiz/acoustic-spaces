msgid "Run details"
msgstr "Detalles del cálculo"

#: acoustic_spaces/gui/results_view.py
msgid ""
"What the run did: its settings per source, and the paths it found per pair"
msgstr ""
"Lo que hizo el cálculo: su configuración por fuente y las trayectorias que "
"encontró por pareja"

#: acoustic_spaces/gui/results_view.py
msgid "Run the simulation (F5) to see results here."
msgstr "Calcular la simulación (F5) para ver aquí los resultados."

#: acoustic_spaces/gui/results_view.py
msgid "The scene changed since this run; run again to update the results."
msgstr ""
"La escena cambió desde este cálculo; hay que volver a calcular para "
"actualizar los resultados."

#: acoustic_spaces/gui/results_view.py
msgid ""
"The absorption changed since this run: these results re-weight its rays. Run "
"again to trace them afresh."
msgstr ""
"La absorción cambió desde este cálculo: estos resultados vuelven a ponderar "
"sus rayos. Hay que volver a calcular para trazarlos de nuevo."

#. Translators: {tip} is what a parameter means.
#: acoustic_spaces/gui/results_view.py
#, python-brace-format
