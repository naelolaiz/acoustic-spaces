msgid "Room parameters on a grid over the audience area, for every source"
msgstr ""
"Parámetros acústicos en una malla sobre la zona de público, para cada fuente"

#: acoustic_spaces/gui/app.py
msgid "Map"
msgstr "Mapa"

#: acoustic_spaces/gui/app.py
msgid "&Tune CPU and GPU…"
msgstr "&Ajustar CPU y GPU…"

#: acoustic_spaces/gui/app.py
msgid ""
"Time the CPU and the GPU on this scene and keep the fastest on this computer "
"for the device setting auto (acoustic-spaces tune; needs the gpu extra)"
msgstr ""
"Medir los tiempos de la CPU y la GPU con esta escena y guardar el más rápido "
"de este equipo para el dispositivo auto (acoustic-spaces tune; requiere el "
"extra gpu)"

#: acoustic_spaces/gui/app.py
msgid "&Cancel"
msgstr "Ca&ncelar"

#: acoustic_spaces/gui/app.py
msgid "Stop the run, coverage map or tuning going on, at its next stage"
msgstr ""
"Detener el cálculo, el mapa de cobertura o el ajuste en curso, en su "
"siguiente etapa"

#: acoustic_spaces/gui/app.py
msgid "S&top playback"
msgstr "&Detener reproducción"

#: acoustic_spaces/gui/app.py
msgid "Stop the recording playing through the room (Esc)"
msgstr "Detener la grabación que se reproduce a través del recinto (Esc)"

#: acoustic_spaces/gui/app.py
msgid "Stop playback (Esc)"
msgstr "Detener la reproducción (Esc)"

