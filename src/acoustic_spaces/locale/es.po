#: acoustic_spaces/gui/tree.py
msgid "The scene: its name, default material and air"
msgstr "La escena: su nombre, su material predeterminado y el aire"

#: acoustic_spaces/gui/tree.py
msgid "The room's shape: a box, a floor plan or a model file"
msgstr "La forma del recinto: rectangular, una planta o un archivo de modelo"

#: acoustic_spaces/gui/tree.py
