#: acoustic_spaces/gui/tune_dialog.py
msgid "Make auto the default on this computer"
msgstr "Hacer de auto el dispositivo predeterminado de este equipo"

#: acoustic_spaces/gui/tune_dialog.py
msgid "Let this scene follow this computer's default too"
msgstr "Hacer que esta escena también siga el predeterminado de este equipo"

#: acoustic_spaces/gui/tune_dialog.py
msgid "Tune CPU and GPU"
msgstr "Ajustar CPU y GPU"

#: acoustic_spaces/gui/tune_dialog.py
msgid "What the CPU and the GPU took on this computer:"
msgstr "Lo que tardaron la CPU y la GPU en este equipo:"

#: acoustic_spaces/gui/tune_dialog.py
msgid ""
"Scenes whose Run on is default then run on the fastest device found here; "
"unticked, on the CPU"
msgstr ""
"Las escenas con Ejecutar en «predeterminado» se ejecutan entonces en el "
"dispositivo más rápido encontrado aquí; sin marcar, en la CPU"

#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid ""
"Scenes whose Run on is set to default, in the editor and on the command "
"line, then run the late reverberation and the wave solver on the devices "
"marked auto above. Unticked, they run on the CPU. The default now: {device}."
msgstr ""
"Las escenas con Ejecutar en «predeterminado», en el editor y en la línea de "
"comandos, calculan entonces la reverberación tardía y el método ondulatorio "
"en los dispositivos marcados como auto arriba. Sin marcar, se ejecutan en la "
"CPU. Predeterminado actual: {device}."

#. Translators: {late} and {wave} are devices, such as cpu or gpu.
#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid "late reverberation on {late} and wave solver on {wave}"
msgstr "reverberación tardía en {late} y método ondulatorio en {wave}"

#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid "late reverberation on {late}"
msgstr "reverberación tardía en {late}"

#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid "wave solver on {wave}"
msgstr "método ondulatorio en {wave}"

#: acoustic_spaces/gui/tune_dialog.py
msgid ""
"Set this scene's Run on back to default, so that it follows this computer's "
"default"
msgstr ""
"Devolver Ejecutar en de esta escena a «predeterminado», para que siga el "
"predeterminado de este equipo"

#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid ""
"This scene names its own devices ({devices}), so the default does not apply "
"to it. Ticked, OK sets its Run on back to default (Edit > Undo takes that "
"back)."
msgstr ""
"Esta escena indica sus propios dispositivos ({devices}), así que el "
"predeterminado no se le aplica. Marcado, Aceptar devuelve su Ejecutar en a "
"«predeterminado» (Editar > Deshacer lo revierte)."

#: acoustic_spaces/gui/tune_dialog.py
#, python-brace-format
msgid "Save the timings and the choices above in {path}"
msgstr "Guardar los tiempos y las opciones de arriba en {path}"

#: acoustic_spaces/gui/tune_dialog.py
msgid "Close without saving anything, not even the timings"
msgstr "Cerrar sin guardar nada, ni siquiera los tiempos"

#: acoustic_spaces/gui/tune_dialog.py
msgid "OK saves the timings and the choices above. Cancel saves nothing."
msgstr ""
"Aceptar guarda los tiempos y las opciones de arriba. Cancelar no guarda nada."

#: acoustic_spaces/gui/viewport.py
#, python-brace-format
msgid "The 3D view is not available here: {reason}"
msgstr "La vista 3D no está disponible aquí: {reason}"

#: acoustic_spaces/gui/viewport.py
msgid "The 3D view needs a display with OpenGL."
msgstr "La vista 3D necesita una pantalla con OpenGL."
