msgid_plural "Measured profile at {count} heights, from the scene file"
msgstr[0] "Perfil medido en {count} altura, del archivo de escena"
msgstr[1] "Perfil medido en {count} alturas, del archivo de escena"

#: acoustic_spaces/gui/inspector.py
