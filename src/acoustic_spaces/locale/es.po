msgstr "Mostrar el recinto completo en la vista 3D desde el ángulo habitual"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "Vista &3D"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "Mostrar el recinto en 3D"

