msgstr "Superficie: {area:,.1f} m²"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³ in {count} room ({each} m³)"
msgid_plural "Volume: {volume:,.1f} m³ in {count} rooms ({each} m³)"
msgstr[0] "Volumen: {volume:,.1f} m³ en {count} recinto ({each} m³)"
msgstr[1] "Volumen: {volume:,.1f} m³ en {count} recintos ({each} m³)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Volume: {volume:,.1f} m³"
msgstr "Volumen: {volume:,.1f} m³"

#: acoustic_spaces/gui/inspector.py
msgid "Volume: model not closed"
msgstr "Volumen: modelo no cerrado"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
