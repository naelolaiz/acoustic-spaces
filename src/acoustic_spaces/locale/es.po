msgstr "En marcha desde hace {time:.0f} s"

#
#: acoustic_spaces/gui/activity.py
msgid ""
"Cancel, or Simulation > Cancel (Shift+F5), stops it: a run at its next "
"stage, a demo at once"
msgstr ""
"Cancelar, o Simulación > Cancelar (Mayús+F5), la detiene: un cálculo en su "
"siguiente etapa, una demostración al momento"

#: acoustic_spaces/gui/app.py
msgid "Acoustic Spaces editor"
msgstr "Editor de Acoustic Spaces"

#: acoustic_spaces/gui/app.py
msgid "Scenes (*.yaml *.yml)"
msgstr "Escenas (*.yaml *.yml)"

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New building with {count} corners, {height:g} m high; change its height "
"under Geometry."
msgstr ""
"Edificio nuevo de {count} vértices y {height:g} m de altura; la altura se "
"cambia en Geometría."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New barrier along {count} points, {height:g} m high; change its height under "
"Geometry."
msgstr ""
"Pantalla nueva de {count} puntos y {height:g} m de altura; la altura se "
"cambia en Geometría."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New belt of trees with {count} corners, {height:g} m high, with dense "
"foliage; change its height under Geometry and the rest in the scene file."
msgstr ""
"Franja de árboles nueva de {count} vértices y {height:g} m de altura, con "
"follaje denso; la altura se cambia en Geometría y el resto en el archivo de "
"escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New hedge along {count} points, {width:g} m wide and {height:g} m high, with "
"dense foliage; change its height under Geometry and the rest in the scene "
"file."
msgstr ""
"Seto nuevo de {count} puntos, {width:g} m de ancho y {height:g} m de altura, "
"con follaje denso; la altura se cambia en Geometría y el resto en el archivo "
"de escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New tree {height:g} m high, its crown {crown_diameter:g} m across from "
"{base:g} m up, with dense foliage; change its height under Geometry and the "
"rest in the scene file."
msgstr ""
"Árbol nuevo de {height:g} m de altura, con la copa de {crown_diameter:g} m "
"de diámetro desde {base:g} m de alto y follaje denso; la altura se cambia en "
"Geometría y el resto en el archivo de escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New ground zone with {count} corners; give its surface a material of its own "
"in the scene tree."
msgstr ""
"Zona del terreno nueva de {count} vértices; asigne un material propio a su "
"superficie en el árbol de la escena."

#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid ""
"New weather zone with {count} corners; choose it under Weather of in the "
"scene's entry to give it wind and temperature of its own."
msgstr ""
"Zona meteorológica nueva de {count} vértices; elíjala en Tiempo de, en la "
"entrada de la escena, para darle viento y temperatura propios."

#. Translators: {patterns} is the list of model file patterns, such as *.obj *.dxf.
#: acoustic_spaces/gui/app.py
#, python-brace-format
msgid "Models ({patterns})"
msgstr "Modelos ({patterns})"

#: acoustic_spaces/gui/app.py
msgid "glTF binary (*.glb)"
msgstr "glTF binario (*.glb)"

#: acoustic_spaces/gui/app.py
msgid "Pack (*.zip)"
msgstr "Paquete (*.zip)"

#. Translators: two file types of a save dialog, kept apart by ;; (keep it).
#: acoustic_spaces/gui/app.py
msgid "PNG picture (*.png);;JSON, every map (*.json)"
msgstr "Imagen PNG (*.png);;JSON, todos los mapas (*.json)"

#: acoustic_spaces/gui/app.py
msgid "3D view"
msgstr "Vista 3D"

#: acoustic_spaces/gui/app.py
msgid "Plan"
msgstr "Planta"

#: acoustic_spaces/gui/app.py
msgid "The room in 3D: click to select, drag sources and listeners"
msgstr ""
"El recinto en 3D: clic para seleccionar; arrastrar fuentes y receptores"

#: acoustic_spaces/gui/app.py
msgid "The room from above: draw floor plans, drag corners and points"
msgstr ""
"El recinto visto desde arriba: dibujar plantas; arrastrar vértices y puntos"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Scene"
msgstr "Escena"

#: acoustic_spaces/gui/app.py
msgid "Properties"
msgstr "Propiedades"

#: acoustic_spaces/gui/app.py
msgid "Results"
msgstr "Resultados"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/tree.py
msgid "Coverage map"
msgstr "Mapa de cobertura"

#: acoustic_spaces/gui/app.py
msgid "Messages"
msgstr "Mensajes"

#: acoustic_spaces/gui/app.py acoustic_spaces/gui/demo_dialog.py
msgid "Movement"
msgstr "Movimiento"

#: acoustic_spaces/gui/app.py
msgid ""
"What plays through the room: the recording, and the source and listener of "
"the response it plays through"
msgstr ""
"Lo que se reproduce a través del recinto: la grabación, y la fuente y el "
"receptor de la respuesta por la que pasa"

#: acoustic_spaces/gui/app.py
msgid "&New box room…"
msgstr "&Nuevo recinto rectangular…"

#: acoustic_spaces/gui/app.py
msgid "Start a new scene in a box-shaped room"
msgstr "Empezar una escena nueva en un recinto rectangular"

#: acoustic_spaces/gui/app.py
msgid "New from &model file…"
msgstr "Nuevo desde un archivo de &modelo…"

#: acoustic_spaces/gui/app.py
msgid "Start from a model file (OBJ, DXF, glTF, STL, IFC, Collada or SketchUp)"
msgstr ""
"Empezar desde un archivo de modelo (OBJ, DXF, glTF, STL, IFC, Collada o "
"SketchUp)"

#: acoustic_spaces/gui/app.py
msgid "New room from a &floor plan…"
msgstr "Nuevo recinto desde una &planta…"

#: acoustic_spaces/gui/app.py
msgid "Draw the floor plan of a new room, corner by corner"
msgstr "Dibujar la planta de un recinto nuevo, vértice a vértice"

#: acoustic_spaces/gui/app.py
msgid "New o&utdoor scene…"
msgstr "Nueva escena al aire &libre…"

#: acoustic_spaces/gui/app.py
msgid ""
"Start a new scene on open ground, to draw buildings, barriers, vegetation "
"and ground zones on, or to set a terrain and buildings from a map"
msgstr ""
"Empezar una escena nueva sobre terreno abierto, para dibujar en él "
"edificios, pantallas acústicas, vegetación y zonas del terreno, o para "
"ponerle un relieve y edificios desde un mapa"

#: acoustic_spaces/gui/app.py
msgid "&Open…"
msgstr "&Abrir…"

#: acoustic_spaces/gui/app.py
msgid "Open a scene file (YAML)"
msgstr "Abrir un archivo de escena (YAML)"

#: acoustic_spaces/gui/app.py
msgid "&Save"
msgstr "&Guardar"

#: acoustic_spaces/gui/app.py
msgid "Save the scene; an example asks where to keep your copy"
msgstr "Guardar la escena; con un ejemplo se pregunta dónde guardar la copia"

#: acoustic_spaces/gui/app.py
msgid "Save &as…"
msgstr "Guardar &como…"

#: acoustic_spaces/gui/app.py
msgid "Save the scene in another file"
msgstr "Guardar la escena en otro archivo"

#: acoustic_spaces/gui/app.py
msgid "&Export results…"
msgstr "E&xportar resultados…"

#: acoustic_spaces/gui/app.py
msgid ""
"Write every response of the last run to a folder: a WAV file per output "
"format and parameters.json, as acoustic-spaces simulate does"
msgstr ""
"Escribir todas las respuestas del último cálculo en una carpeta: un archivo "
"WAV por formato de salida y parameters.json, como hace acoustic-spaces "
"simulate"

#: acoustic_spaces/gui/app.py
msgid "Export to &Blender…"
msgstr "Exportar a &Blender…"

#: acoustic_spaces/gui/app.py
msgid "The room, and the reflection paths on show, as glTF"
msgstr "El recinto y las trayectorias de reflexión visibles, en glTF"

#: acoustic_spaces/gui/app.py
msgid "Export &particle animation to Blender…"
msgstr "Exportar animación de pa&rtículas a Blender…"

#: acoustic_spaces/gui/app.py
msgid ""
"Sound particles from the selected source (or the first) as a glTF animation: "
"as much of the sound, as slowly and as many particles as you choose"
msgstr ""
"Partículas sonoras de la fuente seleccionada (o de la primera) como "
"animación glTF: tanto sonido, tan despacio y tantas partículas como elija"

#: acoustic_spaces/gui/app.py
msgid "Pac&k for another computer…"
msgstr "Empa&quetar para otro equipo…"

#: acoustic_spaces/gui/app.py
msgid ""
"Put the scene and every file it names in one zip file, to run on a server or "
"a cloud job as acoustic-spaces pack does; nothing is uploaded"
msgstr ""
"Reúne la escena y todos los archivos que nombra en un solo archivo zip, para "
"calcularla en un servidor o en un trabajo en la nube, como hace "
"acoustic-spaces pack; no se sube nada"

#: acoustic_spaces/gui/app.py
msgid "&Quit"
msgstr "&Salir"

#: acoustic_spaces/gui/app.py
msgid "Close the editor; it asks about unsaved changes"
msgstr "Cerrar el editor; antes pregunta por los cambios sin guardar"

#. Translators: {edit} says what the last edit did, such as "move the source".
#: acoustic_spaces/gui/app.py
msgid "&Undo"
msgstr "&Deshacer"

#: acoustic_spaces/gui/app.py
msgid "Take back the last change"
msgstr "Deshacer el último cambio"

#: acoustic_spaces/gui/app.py
msgid "&Redo"
msgstr "&Rehacer"

#: acoustic_spaces/gui/app.py
msgid "Make the change Undo took back"
msgstr "Volver a aplicar el cambio deshecho"

#: acoustic_spaces/gui/app.py
msgid "Place &source"
msgstr "Colocar &fuente"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a source there"
msgstr ""
"Hacer clic en un suelo o una pared de la vista 3D para colocar allí una "
"fuente"

#: acoustic_spaces/gui/app.py
msgid "Place &listener"
msgstr "Colocar recep&tor"

#: acoustic_spaces/gui/app.py
msgid "Click a floor or wall in the 3D view to put a listener there"
msgstr ""
"Hacer clic en un suelo o una pared de la vista 3D para colocar allí un "
"receptor"

#: acoustic_spaces/gui/app.py
msgid "&Draw floor plan"
msgstr "Dibujar &planta"

#: acoustic_spaces/gui/app.py
msgid "Draw a new floor plan in the plan view; it replaces the room"
msgstr "Dibujar una planta nueva en la vista de planta; sustituye al recinto"

#: acoustic_spaces/gui/app.py
msgid "Add &material from the database…"
msgstr "Añadir &material de la base de datos…"

#: acoustic_spaces/gui/app.py
msgid "A material of the built-in database of absorption coefficients"
msgstr "Un material de la base de datos integrada de coeficientes de absorción"

#: acoustic_spaces/gui/app.py
msgid "Add material from a &library…"
msgstr "Añadir material de una &biblioteca…"

#: acoustic_spaces/gui/app.py
msgid ""
"A material of a CATT-Acoustic (ABS lines) or ODEON (.Li8) material library"
msgstr ""
"Un material de una biblioteca de materiales de CATT-Acoustic (líneas ABS) u "
"ODEON (.Li8)"

#: acoustic_spaces/gui/app.py
msgid "Re&move selected"
msgstr "&Eliminar selección"

#: acoustic_spaces/gui/app.py
msgid ""
"Remove the selected source, listener or material (Delete, in the scene tree "
"or a view)"
msgstr ""
"Eliminar la fuente, el receptor o el material seleccionado (Supr, en el "
"árbol de la escena o en una vista)"

#: acoustic_spaces/gui/app.py
msgid "&Reset camera"
msgstr "&Restablecer cámara"

#: acoustic_spaces/gui/app.py
msgid "Show the whole room in the 3D view from the usual angle"
msgstr "Mostrar el recinto completo en la vista 3D desde el ángulo habitual"

#: acoustic_spaces/gui/app.py
msgid "&3D view"
msgstr "Vista &3D"

#: acoustic_spaces/gui/app.py
msgid "Show the room in 3D"
msgstr "Mostrar el recinto en 3D"

#: acoustic_spaces/gui/app.py
msgid "P&lan"
msgstr "P&lanta"

#: acoustic_spaces/gui/app.py
msgid "Show the room from above, to draw and change floor plans"
msgstr ""
"Mostrar el recinto visto desde arriba, para dibujar y modificar plantas"

#: acoustic_spaces/gui/app.py
msgid "Edit &movement…"
msgstr "Editar mo&vimiento…"

#: acoustic_spaces/gui/app.py
msgid ""
"Open the Movement panel: where the selected source or listener is and how it "
"faces at each time of a movement, with a timeline every mover is previewed "
"along"
msgstr ""
"Abrir el panel Movimiento: dónde está y hacia dónde mira la fuente o el "
"receptor seleccionado en cada instante de un movimiento, con una línea de "
"tiempo por la que se previsualizan todos los móviles"

#: acoustic_spaces/gui/app.py
msgid "Show reflection &paths"
msgstr "Mostrar &trayectorias de reflexión"

#: acoustic_spaces/gui/app.py
msgid ""
"Draw the early reflection paths of the source and listener the Results panel "
"shows, coloured by order"
msgstr ""
"Dibujar las trayectorias de las primeras reflexiones de la fuente y el "
"receptor que muestra el panel Resultados, coloreadas por orden"

#: acoustic_spaces/gui/app.py
msgid "Show &leaks"
msgstr "Mostrar &fugas"

#: acoustic_spaces/gui/app.py
msgid ""
"Trace rays from the sources and show where they escape from a model that is "
"not closed"
msgstr ""
"Trazar rayos desde las fuentes y mostrar por dónde escapan de un modelo que "
"no está cerrado"

#: acoustic_spaces/gui/app.py
msgid "Show &wind"
msgstr "Mostrar &viento"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, draw the wind in the 3D view and the plan: arrows the way it "
"blows, as long as it is strong, at the height the scene gives its speed at, "
"and each weather zone with its wind"
msgstr ""
"Al aire libre, dibujar el viento en la vista 3D y en la planta: flechas en "
"la dirección en que sopla, tan largas como fuerte es, a la altura a la que "
"la escena da su velocidad, y cada zona meteorológica con su viento"

#: acoustic_spaces/gui/app.py
msgid "Show wind pro&file"
msgstr "Mostrar p&erfil del viento"

#: acoustic_spaces/gui/app.py
msgid ""
"Outdoors, stand a mast in the 3D view in each weather where the wind blows, "
"with arrows up it and a curve: how the wind grows with height over the ground"
msgstr ""
"Al aire libre, levantar en la vista 3D un mástil en la escena y en cada zona "
"meteorológica donde sopla el viento, con flechas a lo largo de él y una "
"curva: cómo crece el viento con la altura sobre el terreno"

#: acoustic_spaces/gui/app.py
msgid "Save &screenshot…"
msgstr "Guardar &captura de pantalla…"

#: acoustic_spaces/gui/app.py
msgid "Save the 3D view as a PNG picture"
msgstr "Guardar la vista 3D como imagen PNG"

#: acoustic_spaces/gui/app.py
msgid "&Run"
msgstr "&Calcular"

#: acoustic_spaces/gui/app.py
msgid "Simulate every source and listener"
msgstr "Simular todas las fuentes y todos los receptores"

#: acoustic_spaces/gui/app.py
msgid "Run coverage &map"
msgstr "Calcular &mapa de cobertura"

#: acoustic_spaces/gui/app.py
msgid "Room parameters on a grid over the audience area, for every source"
msgstr ""
"Parámetros acústicos en una malla sobre la zona de público, para cada fuente"

#: acoustic_spaces/gui/app.py
msgid "Map"
msgstr "Mapa"

#: acoustic_spaces/gui/app.py
msgid "&Tune CPU and GPU…"
msgstr "&Ajustar CPU y GPU…"

#: acoustic_spaces/gui/app.py
msgid ""
"Time the CPU and the GPU on this scene and keep the fastest on this computer "
"for the device setting auto (acoustic-spaces tune; needs the gpu extra)"
msgstr ""
"Medir los tiempos de la CPU y la GPU con esta escena y guardar el más rápido "
"de este equipo para el dispositivo auto (acoustic-spaces tune; requiere el "
"extra gpu)"

#: acoustic_spaces/gui/app.py
msgid "Run &demo…"
msgstr "Ejecutar una demos&tración…"

#: acoustic_spaces/gui/app.py
msgid ""
"Play the sounds each source's Plays names through the open scene: its "
"simulation, what each listener hears and a video, with the options to fill "
"in; an example's scene also has the example's own demo"
msgstr ""
"Reproduce en la escena abierta los sonidos que indica el campo Reproduce de "
"cada fuente: su simulación, lo que oye cada oyente y un vídeo, con las "
"opciones por rellenar; la escena de un ejemplo tiene además la demostración "
"propia del ejemplo"

#: acoustic_spaces/gui/app.py
msgid "&Cancel"
msgstr "Ca&ncelar"

#
#: acoustic_spaces/gui/app.py
msgid ""
"Stop the run, coverage map or tuning going on at its next stage, or a demo "
"at once"
msgstr ""
"Detener el cálculo, el mapa de cobertura o el ajuste en curso en su "
"siguiente etapa, o una demostración al momento"

#: acoustic_spaces/gui/app.py
msgid "S&top playback"
msgstr "&Detener reproducción"

#: acoustic_spaces/gui/app.py
msgid "Stop the recording playing through the room (Esc)"
msgstr "Detener la grabación que se reproduce a través del recinto (Esc)"

#: acoustic_spaces/gui/app.py
msgid "Stop playback (Esc)"
msgstr "Detener la reproducción (Esc)"

