msgid ""
"Ground from ({x0:g}, {y0:g}) to ({x1:g}, {y1:g}) m, sky {sky:g} m over it"
msgstr ""
"Terreno de ({x0:g}, {y0:g}) a ({x1:g}, {y1:g}) m, cielo a {sky:g} m por "
"encima"

