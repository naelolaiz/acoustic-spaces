msgstr ""
"pérdida por inserción ponderada A de los edificios, pantallas acústicas o "
"vegetación"

#: acoustic_spaces/engine/coverage.py acoustic_spaces/gui/results_view.py
msgid "Long-term level (dB)"
msgstr "Nivel a largo plazo (dB)"

