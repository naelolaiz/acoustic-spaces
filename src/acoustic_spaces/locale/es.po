"Reverberation time at {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s "
"(Sabine)"
msgstr ""
"Tiempo de reverberación a {band}: {eyring:.2f} s (Eyring), {sabine:.2f} s "
"(Sabine)"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Problem: {problem}"
msgstr "Problema: {problem}"

#: acoustic_spaces/gui/inspector.py
#, python-brace-format
msgid "Warning: {warning}"
msgstr "Aviso: {warning}"

#: acoustic_spaces/gui/inspector.py
msgid "rename scene"
msgstr "cambiar nombre de la escena"

#: acoustic_spaces/gui/inspector.py
msgid "change default material"
msgstr "cambiar material predeterminado"

#: acoustic_spaces/gui/inspector.py
msgid "change air"
msgstr "modificar aire"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather"
msgstr "modificar el tiempo"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather zone"
msgstr "cambiar la zona meteorológica"

#: acoustic_spaces/gui/inspector.py
msgid "change the weather class"
msgstr "cambiar la clase meteorológica"

#: acoustic_spaces/gui/inspector.py
msgid "add weather class"
msgstr "añadir clase meteorológica"

#: acoustic_spaces/gui/inspector.py
msgid "remove weather class"
msgstr "eliminar clase meteorológica"

#: acoustic_spaces/gui/inspector.py
msgid "a share of the time is a number from 0 to 100 %"
msgstr "una parte del tiempo es un número de 0 a 100 %"

