+def covered(z: np.ndarray, height: float) -> np.ndarray:
+    """(n,) the share of each height step's cell (the ground's sample: half a cell) that
+    keeps its field behind a thin screen of ``height`` (m) on the grid of heights ``z``."""
+    dz = float(z[1] - z[0])
+    low = np.maximum(z - 0.5 * dz, 0.0)
+    high = z + 0.5 * dz
+    return np.clip((high - height) / (high - low), 0.0, 1.0)
+
